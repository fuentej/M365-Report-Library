{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-by-action",
  "position": {
    "x": 430,
    "y": 260,
    "z": 0,
    "width": 420,
    "height": 200,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "TransportRules"
                    }
                  },
                  "Property": "ActionLabel"
                }
              },
              "queryRef": "TransportRules.ActionLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "TransportRules"
                    }
                  },
                  "Property": "Mail Flow Rules"
                }
              },
              "queryRef": "TransportRules.Mail Flow Rules"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Rules by action"
          }
        }
      ]
    }
  }
}
