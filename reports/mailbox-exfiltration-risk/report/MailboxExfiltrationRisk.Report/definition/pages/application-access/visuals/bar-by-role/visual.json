{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar-by-role",
  "position": {
    "x": 430,
    "y": 260,
    "z": 0,
    "width": 420,
    "height": 200,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "AppRoleAssignments"
                    }
                  },
                  "Property": "AppRoleValue"
                }
              },
              "queryRef": "AppRoleAssignments.AppRoleValue",
              "nativeQueryRef": "AppRoleValue",
              "displayName": "Application permission"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "AppRoleAssignments"
                    }
                  },
                  "Property": "App Role Assignments"
                }
              },
              "queryRef": "AppRoleAssignments.App Role Assignments",
              "nativeQueryRef": "App Role Assignments"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'App roles held on Microsoft Graph'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}
