{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-changes-by-category",
  "position": {
    "x": 430,
    "y": 260,
    "z": 0,
    "width": 420,
    "height": 200,
    "tabOrder": 13
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "MailboxChangeEvents"
                    }
                  },
                  "Property": "ChangeCategory"
                }
              },
              "queryRef": "MailboxChangeEvents.ChangeCategory"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "MailboxChangeEvents"
                    }
                  },
                  "Property": "Change Events"
                }
              },
              "queryRef": "MailboxChangeEvents.Change Events"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Change events by category"
          }
        }
      ]
    }
  }
}
