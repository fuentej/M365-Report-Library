{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar-by-domain",
  "position": {
    "x": 860,
    "y": 260,
    "z": 0,
    "width": 420,
    "height": 200,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "InboxRules"
                    }
                  },
                  "Property": "TargetDomainsLabel"
                }
              },
              "queryRef": "InboxRules.TargetDomainsLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "InboxRules"
                    }
                  },
                  "Property": "Inbox Rules"
                }
              },
              "queryRef": "InboxRules.Inbox Rules"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Rules by target domain (hidden rules are read but not flagged)"
          }
        }
      ]
    }
  }
}
