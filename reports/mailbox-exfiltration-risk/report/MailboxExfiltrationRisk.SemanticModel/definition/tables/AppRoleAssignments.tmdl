table AppRoleAssignments
    lineageTag: ab67457f-7598-5286-9148-a50ed175eadc

    column RunDate
        dataType: dateTime
        formatString: Short Date
        lineageTag: 865ec2a9-d8a1-59ee-8610-1bf67f55cf4a
        summarizeBy: none
        sourceColumn: RunDate

    column AssignmentId
        dataType: string
        lineageTag: fc2688a2-312d-5a6c-94a2-5e6c6779076c
        summarizeBy: none
        sourceColumn: AssignmentId

    column AppRoleId
        dataType: string
        lineageTag: bc775055-eb0d-5384-8d68-eb2c7ac87912
        summarizeBy: none
        sourceColumn: AppRoleId

    column AppRoleValue
        dataType: string
        lineageTag: 9976944b-5551-56ec-b8ae-f5188ce9fd78
        summarizeBy: none
        sourceColumn: AppRoleValue

    column PrincipalId
        dataType: string
        lineageTag: d2dc969e-2f15-5fe7-83ca-70b8b7133f83
        summarizeBy: none
        sourceColumn: PrincipalId

    column PrincipalDisplayName
        dataType: string
        lineageTag: 060940ba-a5fa-5ef0-92ee-1622b73a1873
        summarizeBy: none
        sourceColumn: PrincipalDisplayName

    column PrincipalType
        dataType: string
        lineageTag: ddc13eb8-d458-50ab-bc6b-665b2118e79e
        summarizeBy: none
        sourceColumn: PrincipalType

    column ResourceId
        dataType: string
        lineageTag: 2ea8b4e9-1639-5f56-b4f5-d5d170898ad3
        summarizeBy: none
        sourceColumn: ResourceId

    column ResourceDisplayName
        dataType: string
        lineageTag: e3bb2c3e-76fa-5b11-9c22-ee1180323ecb
        summarizeBy: none
        sourceColumn: ResourceDisplayName

    column CreatedDateTime
        dataType: dateTime
        formatString: General Date
        lineageTag: f59437ac-59a1-5d71-8626-f7210c1fba8f
        summarizeBy: none
        sourceColumn: CreatedDateTime

    column IsMailRole
        dataType: boolean
        lineageTag: ca62f385-2f5b-5063-bc38-ec4538f4f8ec
        summarizeBy: none
        sourceColumn: IsMailRole

    /// Latest RunDate of this source inside the current date slicer, ignoring the visual's own axis. Blank when the source has no rows (header-only file): not collected, never zero.
    measure 'AppRoleAssignments Snapshot Date' = CALCULATE(MAX(AppRoleAssignments[RunDate]), ALLSELECTED(AppRoleAssignments), ALLSELECTED(Apps))
        formatString: Short Date
        lineageTag: 304eeb8a-5dec-5a73-8ef8-d7d7156a8f7c

    measure 'App Role Assignments' = 
            VAR Snap = [AppRoleAssignments Snapshot Date]
            RETURN IF(ISBLANK(Snap), BLANK(), CALCULATE(COUNTROWS(AppRoleAssignments), AppRoleAssignments[RunDate] = Snap) + 0)
        formatString: #,0
        lineageTag: 68f60b26-77cb-5e4c-88e4-64019faf44e7

    /// An app role starting with Mail. or MailboxSettings. on the Microsoft Graph service principal (this report's rule).
    measure 'Mail App Roles' = 
            VAR Snap = [AppRoleAssignments Snapshot Date]
            RETURN IF(ISBLANK(Snap), BLANK(), CALCULATE(COUNTROWS(AppRoleAssignments), AppRoleAssignments[RunDate] = Snap, AppRoleAssignments[IsMailRole] = TRUE()) + 0)
        formatString: #,0
        lineageTag: 90e04345-990a-5c70-b306-17fb17f897a8

    measure 'Apps Holding Mail App Roles' = 
            VAR Snap = [AppRoleAssignments Snapshot Date]
            RETURN IF(ISBLANK(Snap), BLANK(), CALCULATE(DISTINCTCOUNT(AppRoleAssignments[PrincipalId]), AppRoleAssignments[RunDate] = Snap, AppRoleAssignments[IsMailRole] = TRUE()) + 0)
        formatString: #,0
        lineageTag: 2a3ab284-0283-5c82-b585-4009bc839221

    measure 'App Roles With Unknown Mail Flag' = 
            VAR Snap = [AppRoleAssignments Snapshot Date]
            RETURN IF(ISBLANK(Snap), BLANK(), CALCULATE(COUNTROWS(AppRoleAssignments), AppRoleAssignments[RunDate] = Snap, ISBLANK(AppRoleAssignments[IsMailRole])) + 0)
        formatString: #,0
        lineageTag: 436a1f1f-607f-5634-aea9-431b65cbfd16

    measure 'Mail App Roles (All Snapshots)' = IF(COUNTROWS(AppRoleAssignments) = 0, BLANK(), COUNTROWS(FILTER(AppRoleAssignments, AppRoleAssignments[IsMailRole] = TRUE())) + 0)
        formatString: #,0
        lineageTag: f03b86b4-f4ec-51d9-b303-cb5e487734f9

    /// Apps holding a Microsoft Graph Mail.* application permission (Mail.Read, Mail.ReadBasic, Mail.ReadWrite, Mail.Send) in the latest run: each works on every mailbox without a signed-in user unless an Exchange application access policy or RBAC for Applications scopes it, which this report does not collect. MailboxSettings.* is left out: it reads settings, not mail.
    measure 'Apps Reaching Every Mailbox' =
            VAR LatestRun = [Who Else Latest Run]
            VAR Collected = NOT ISBLANK(CALCULATE(MAX(AppRoleAssignments[RunDate]), ALL(AppRoleAssignments)))
            VAR AppRows = SELECTCOLUMNS(FILTER(ALL(AppRoleAssignments), AppRoleAssignments[RunDate] = LatestRun && LEFT(AppRoleAssignments[AppRoleValue], 5) = "Mail."), "AppKey", LOWER(AppRoleAssignments[PrincipalId]), "Role", AppRoleAssignments[AppRoleValue], "Dt", IF(ISBLANK(AppRoleAssignments[CreatedDateTime]), BLANK(), DATE(YEAR(AppRoleAssignments[CreatedDateTime]), MONTH(AppRoleAssignments[CreatedDateTime]), DAY(AppRoleAssignments[CreatedDateTime]))), "Id", AppRoleAssignments[AssignmentId])
            VAR AppN = COUNTROWS(DISTINCT(SELECTCOLUMNS(AppRows, "K", [AppKey]))) + 0
            RETURN IF(NOT Collected, BLANK(), AppN)
        formatString: #,0
        displayFolder: Who else can read
        lineageTag: 50958ec9-ca12-4583-aea5-e23f19907029

    /// Of the apps reaching every mailbox, those holding Mail.Send: send mail as any user.
    measure 'Mail Apps That Send As Anyone' =
            VAR LatestRun = [Who Else Latest Run]
            VAR Collected = NOT ISBLANK(CALCULATE(MAX(AppRoleAssignments[RunDate]), ALL(AppRoleAssignments)))
            VAR AppRows = SELECTCOLUMNS(FILTER(ALL(AppRoleAssignments), AppRoleAssignments[RunDate] = LatestRun && LEFT(AppRoleAssignments[AppRoleValue], 5) = "Mail."), "AppKey", LOWER(AppRoleAssignments[PrincipalId]), "Role", AppRoleAssignments[AppRoleValue], "Dt", IF(ISBLANK(AppRoleAssignments[CreatedDateTime]), BLANK(), DATE(YEAR(AppRoleAssignments[CreatedDateTime]), MONTH(AppRoleAssignments[CreatedDateTime]), DAY(AppRoleAssignments[CreatedDateTime]))), "Id", AppRoleAssignments[AssignmentId])
            VAR AppN = COUNTROWS(DISTINCT(SELECTCOLUMNS(AppRows, "K", [AppKey]))) + 0
            RETURN IF(NOT Collected, BLANK(), COUNTROWS(DISTINCT(SELECTCOLUMNS(FILTER(AppRows, [Role] = "Mail.Send"), "K", [AppKey]))) + 0)
        formatString: #,0
        displayFolder: Who else can read
        lineageTag: 303d3ca8-9d7b-4dec-a7ec-6e0fd885d04d

    /// Panel subtitle: when the Mail.* application permissions were granted.
    measure 'Mail Apps Window' =
            VAR LatestRun = [Who Else Latest Run]
            VAR Collected = NOT ISBLANK(CALCULATE(MAX(AppRoleAssignments[RunDate]), ALL(AppRoleAssignments)))
            VAR AppRows = SELECTCOLUMNS(FILTER(ALL(AppRoleAssignments), AppRoleAssignments[RunDate] = LatestRun && LEFT(AppRoleAssignments[AppRoleValue], 5) = "Mail."), "AppKey", LOWER(AppRoleAssignments[PrincipalId]), "Role", AppRoleAssignments[AppRoleValue], "Dt", IF(ISBLANK(AppRoleAssignments[CreatedDateTime]), BLANK(), DATE(YEAR(AppRoleAssignments[CreatedDateTime]), MONTH(AppRoleAssignments[CreatedDateTime]), DAY(AppRoleAssignments[CreatedDateTime]))), "Id", AppRoleAssignments[AssignmentId])
            VAR AppN = COUNTROWS(DISTINCT(SELECTCOLUMNS(AppRows, "K", [AppKey]))) + 0
            VAR Dated = FILTER(AppRows, NOT ISBLANK([Dt]))
            VAR FirstGrant = MINX(Dated, [Dt])
            VAR LastGrant = MAXX(Dated, [Dt])
            VAR Days = INT(LastGrant - FirstGrant) + 1
            RETURN
                SWITCH(
                    TRUE(),
                    NOT Collected, "Not collected: app-role-assignments.csv is empty.",
                    AppN = 0, "No app holds a Mail application permission in the latest run.",
                    ISBLANK(FirstGrant), "Grant dates were not collected.",
                    AppN = 1, "Granted on " & FORMAT(FirstGrant, "yyyy-MM-dd") & ".",
                    Days = 1, "All " & AppN & " were granted on " & FORMAT(FirstGrant, "yyyy-MM-dd") & ".",
                    Days <= 31, "All " & AppN & " were granted in one " & Days & "-day window, " & FORMAT(FirstGrant, "yyyy-MM-dd") & " to " & FORMAT(LastGrant, "yyyy-MM-dd") & ".",
                    "Granted between " & FORMAT(FirstGrant, "yyyy-MM-dd") & " and " & FORMAT(LastGrant, "yyyy-MM-dd") & "."
                )
        displayFolder: Who else can read
        lineageTag: 56912c94-f625-4dae-a39c-108422678816

    /// The Apps that can reach every mailbox panel as an SVG image: a timeline of grant dates, then one row per Mail.* application permission (app, permission, what it allows, granted). App names follow the Anonymize toggle. At most 12 rows.
    measure 'Mail Apps Image' =
            VAR LatestRun = [Who Else Latest Run]
            VAR Anon = SELECTEDVALUE(AnonymizeMode[Mode], "Show names") = "Anonymize"
            VAR Collected = NOT ISBLANK(CALCULATE(MAX(AppRoleAssignments[RunDate]), ALL(AppRoleAssignments)))
            VAR AppRows = SELECTCOLUMNS(FILTER(ALL(AppRoleAssignments), AppRoleAssignments[RunDate] = LatestRun && LEFT(AppRoleAssignments[AppRoleValue], 5) = "Mail."), "AppKey", LOWER(AppRoleAssignments[PrincipalId]), "Role", AppRoleAssignments[AppRoleValue], "Dt", IF(ISBLANK(AppRoleAssignments[CreatedDateTime]), BLANK(), DATE(YEAR(AppRoleAssignments[CreatedDateTime]), MONTH(AppRoleAssignments[CreatedDateTime]), DAY(AppRoleAssignments[CreatedDateTime]))), "Id", AppRoleAssignments[AssignmentId], "AppName", VAR NameKey = LOWER(AppRoleAssignments[PrincipalId]) RETURN IF(Anon, IF(NameKey = "", BLANK(), "App " & FORMAT(MOD(SUMX(GENERATESERIES(1, LEN(NameKey)), UNICODE(MID(NameKey, [Value], 1)) * [Value]), 9000) + 1000, "0000")), COALESCE(AppRoleAssignments[PrincipalDisplayName], "Unknown app name")))
            VAR AppN = COUNTROWS(DISTINCT(SELECTCOLUMNS(AppRows, "K", [AppKey]))) + 0
            VAR Dated = FILTER(AppRows, NOT ISBLANK([Dt]))
            VAR FirstGrant = MINX(Dated, [Dt])
            VAR LastGrant = MAXX(Dated, [Dt])
            VAR SpanDays = INT(LastGrant - FirstGrant)
            VAR Bars =
                CONCATENATEX(
                    Dated,
                    VAR BarX = IF(SpanDays = 0, 264, 24 + INT([Dt] - FirstGrant) / SpanDays * 480)
                    VAR BarH = IF([Role] IN {"Mail.Send", "Mail.ReadWrite"}, 28, 18)
                    RETURN "<rect x='" & ROUND(BarX - 5, 1) & "' y='" & (54 - BarH) & "' width='10' height='" & BarH & "' fill='" & SWITCH([Role], "Mail.ReadWrite", "%23D98A00", "Mail.Send", "%23C62828", "Mail.Read", "%2316324A", "%235B6B78") & "'/>",
                    "",
                    [Dt], ASC
                )
            VAR MidGrant = FirstGrant + INT(SpanDays / 2)
            VAR AxisSvg = IF(ISBLANK(FirstGrant), "", "<line x1='18' y1='54' x2='516' y2='54' stroke='%23A9B7C2'/>" & "<text x='" & IF(SpanDays = 0, 264, 24) & "' y='70' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='9.5' fill='%235B6B78'>" & FORMAT(FirstGrant, "MMM d") & "</text>" & IF(SpanDays >= 2, "<text x='264' y='70' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='9.5' fill='%235B6B78'>" & FORMAT(MidGrant, "MMM d") & "</text>") & IF(SpanDays >= 1, "<text x='504' y='70' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='9.5' fill='%235B6B78'>" & FORMAT(LastGrant, "MMM d") & "</text>"))
            VAR Keyed = ADDCOLUMNS(AppRows, "SortKey", IF(ISBLANK([Dt]), "99999999", FORMAT([Dt], "yyyyMMdd")) & "|" & [AppName] & "|" & [Id])
            VAR Ranked = ADDCOLUMNS(Keyed, "Rk", VAR ThisSort = [SortKey] RETURN COUNTROWS(FILTER(Keyed, [SortKey] < ThisSort)) + 1)
            VAR RowN = COUNTROWS(Keyed) + 0
            VAR ShownN = IF(RowN > 12, 11, RowN)
            VAR AppRowSvg =
                CONCATENATEX(
                    FILTER(Ranked, [Rk] <= ShownN),
                    VAR RowTop = 86 + ([Rk] - 1) * 31
                    VAR AppText = IF(LEN([AppName]) > 26, LEFT([AppName], 25) & UNICHAR(8230), [AppName])
                    VAR RoleText = IF(LEN([Role]) > 18, LEFT([Role], 17) & UNICHAR(8230), [Role])
                    VAR Meaning = SWITCH([Role], "Mail.ReadWrite", "read, change and delete any mail", "Mail.Read", "read any mail", "Mail.Send", "send as any user", "Mail.ReadBasic", "read any mail except the body", "Mail.ReadBasic.All", "read any mail except the body", "mail access in every mailbox")
                    RETURN
                        "<text x='0' y='" & (RowTop + 20) & "' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='%231F2A33'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(AppText, "%", "%25"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "#", "%23"), UNICHAR(8220), "%E2%80%9C"), UNICHAR(8221), "%E2%80%9D"), UNICHAR(183), "%C2%B7"), UNICHAR(8230), "%E2%80%A6"), UNICHAR(8217), "%E2%80%99") & "</text>"
                            & "<rect x='182' y='" & (RowTop + 8) & "' width='106' height='17' fill='" & SWITCH([Role], "Mail.ReadWrite", "%23D98A00", "Mail.Send", "%23C62828", "Mail.Read", "%2316324A", "%235B6B78") & "'/>"
                            & "<text x='235' y='" & (RowTop + 20.5) & "' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='9.5' font-weight='600' fill='%23FFFFFF'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(RoleText, "%", "%25"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "#", "%23"), UNICHAR(8220), "%E2%80%9C"), UNICHAR(8221), "%E2%80%9D"), UNICHAR(183), "%C2%B7"), UNICHAR(8230), "%E2%80%A6"), UNICHAR(8217), "%E2%80%99") & "</text>"
                            & "<text x='298' y='" & (RowTop + 20) & "' font-family='Segoe UI, sans-serif' font-size='10.5' fill='%233D4C58'>" & Meaning & "</text>"
                            & "<text x='536' y='" & (RowTop + 20) & "' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='11' fill='%233D4C58'>" & IF(ISBLANK([Dt]), "date unknown", FORMAT([Dt], "yyyy-MM-dd")) & "</text>"
                            & "<line x1='0' y1='" & (RowTop + 31) & "' x2='536' y2='" & (RowTop + 31) & "' stroke='%23EEF1F4'/>",
                    "",
                    [Rk], ASC
                )
            VAR MoreNote = IF(RowN > ShownN, "<text x='0' y='" & (86 + ShownN * 31 + 20) & "' font-family='Segoe UI, sans-serif' font-size='10.5' fill='%235B6B78'>+" & (RowN - ShownN) & " more permissions</text>")
            VAR EmptyNote = IF(RowN = 0, "<text x='0' y='100' font-family='Segoe UI, sans-serif' font-size='11' fill='%235B6B78'>" & IF(NOT Collected, "Not collected: app-role-assignments.csv is empty.", "No app holds a Mail application permission in the latest run.") & "</text>")
            RETURN
                "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1072' height='916' viewBox='0 0 536 458'>" & Bars & AxisSvg & AppRowSvg & MoreNote & EmptyNote & "</svg>"
        dataCategory: ImageUrl
        displayFolder: Who else can read
        lineageTag: a389ad09-4d88-4371-adfc-365cd45d0417

    /// Panel footnote: application permissions need no signed-in user, plus apps consented for all users (AllPrincipals) with a Mail.* delegated scope in the latest run.
    measure 'Mail Apps Footnote' =
            VAR LatestRun = [Who Else Latest Run]
            VAR ConsentsCollected = NOT ISBLANK(CALCULATE(MAX(DelegatedConsents[RunDate]), ALL(DelegatedConsents)))
            VAR TenantWide = SELECTCOLUMNS(FILTER(ALL(DelegatedConsents), DelegatedConsents[RunDate] = LatestRun && DelegatedConsents[ConsentType] = "AllPrincipals"), "CId", DelegatedConsents[ClientId], "ScopePath", SUBSTITUTE(TRIM(DelegatedConsents[Scope]), " ", "|"))
            VAR Tokens = ADDCOLUMNS(GENERATE(TenantWide, GENERATESERIES(1, MAX(1, PATHLENGTH([ScopePath])))), "Tok", PATHITEM([ScopePath], [Value]))
            VAR MailTokens = FILTER(Tokens, LEFT([Tok], 5) = "Mail.")
            VAR ConsentAppN = COUNTROWS(DISTINCT(SELECTCOLUMNS(MailTokens, "C", [CId]))) + 0
            VAR ScopeList = CONCATENATEX(DISTINCT(SELECTCOLUMNS(MailTokens, "T", [Tok])), [T], " or ", [T], ASC)
            RETURN
                "Application permissions, not delegated: each app works on every mailbox without a signed-in user."
                    & IF(NOT ConsentsCollected, " Delegated consents were not collected.", IF(ConsentAppN > 0, " Plus " & ConsentAppN & IF(ConsentAppN = 1, " app", " apps") & " consented for all users with " & ScopeList & ".", ""))
        displayFolder: Who else can read
        lineageTag: 2608cef0-1ea3-4dae-9404-734e8d306adb

    partition AppRoleAssignments = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\app-role-assignments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                ParseUtc = (value as nullable text) as nullable datetime =>
                    if value = null then null else DateTime.FromText(value, [Format="yyyy-MM-dd'T'HH:mm:ss'Z'", Culture="en-US"]),
                Parsed = Table.TransformColumns(Cleaned, {{"CreatedDateTime", ParseUtc, type datetime}}),
                #"Changed Type" = Table.TransformColumnTypes(Parsed, {{"RunDate", type date}, {"IsMailRole", type logical}})
            in
                #"Changed Type"

    annotation PBI_ResultType = Table
