{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-age",
  "position": {
    "x": 0,
    "y": 260,
    "z": 0,
    "width": 620,
    "height": 200,
    "tabOrder": 9
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "UserSignInActivity"
                    }
                  },
                  "Property": "SignInAgeBucket"
                }
              },
              "queryRef": "UserSignInActivity.SignInAgeBucket"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "UserSignInActivity"
                    }
                  },
                  "Property": "Users With Sign-In Data"
                }
              },
              "queryRef": "UserSignInActivity.Users With Sign-In Data"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Users by days since last successful sign-in"
          }
        }
      ]
    }
  }
}
