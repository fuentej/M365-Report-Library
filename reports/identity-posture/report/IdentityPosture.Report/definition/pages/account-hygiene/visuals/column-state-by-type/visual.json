{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-state-by-type",
  "position": {
    "x": 640,
    "y": 260,
    "z": 0,
    "width": 640,
    "height": 200,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Users"
                    }
                  },
                  "Property": "UserType"
                }
              },
              "queryRef": "Users.UserType"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Users"
                    }
                  },
                  "Property": "Enabled Users"
                }
              },
              "queryRef": "Users.Enabled Users"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Users"
                    }
                  },
                  "Property": "Disabled Users"
                }
              },
              "queryRef": "Users.Disabled Users"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Users"
                    }
                  },
                  "Property": "Unknown Account Status"
                }
              },
              "queryRef": "Users.Unknown Account Status"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Account state by user type"
          }
        }
      ]
    }
  }
}
