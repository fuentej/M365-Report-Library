table RoleDefinitions
    lineageTag: 6e0c4113-d381-5006-9f8d-07c620a4f904

    column RoleDefinitionId
        dataType: string
        lineageTag: f7ef9c9f-101a-5444-aded-fdce532f9621
        summarizeBy: none
        isNameInferred
        sourceColumn: [RoleDefinitionId]

    /// Built-in role name for a role definition ID. Built-in roles use their template ID as the role definition ID; the IDs and names are from the Microsoft Entra built-in roles page (https://learn.microsoft.com/entra/identity/role-based-access-control/permissions-reference), with Administrator shortened to Admin as on the approved page. A custom or unlisted role shows "Role " and the first 8 characters of its ID.
    column 'Role Name' =
            SWITCH(
                RoleDefinitions[RoleDefinitionId],
                "62e90394-69f5-4237-9190-012177145e10", "Global Admin",
                "fe930be7-5e62-47db-91af-98c3a49a38b1", "User Admin",
                "5d6b6bb7-de71-4623-b4af-96380a352509", "Security Reader",
                "194ae4cb-b126-40b2-bd5b-6091b380977d", "Security Admin",
                "5f2222b1-57c3-48ba-8ad5-d4759f1fde6f", "Security Operator",
                "f2ef992c-3afb-46b9-b7cf-a126ee74c451", "Global Reader",
                "e8611ab8-c189-46e8-94e1-60213ab1f814", "Privileged Role Admin",
                "7be44c8a-adaf-4e2a-84d6-ab2649e08a13", "Privileged Authentication Admin",
                "b1be1c3e-b65d-4f19-8427-f6fa0d97feb9", "Conditional Access Admin",
                "9b895d92-2cd3-44c7-9d02-a6ac2d5ea5c3", "Application Admin",
                "729827e3-9c14-49f7-bb1b-9608f156bbb8", "Helpdesk Admin",
                "fdd7a751-b60b-444a-984c-02652fe8fa1c", "Groups Admin",
                "8ac3fc64-6eca-42ea-9e69-59f4c7b60eb2", "Hybrid Identity Admin",
                "f28a1f50-f6e7-4571-818b-6a12f2af6b6c", "SharePoint Admin",
                "69091246-20e8-4a56-aa4d-066075b2a7a8", "Teams Admin",
                "4a5d8f65-41da-4de4-8968-e035b65339cf", "Reports Reader",
                "Role " & LEFT(RoleDefinitions[RoleDefinitionId], 8)
            )
        dataType: string
        lineageTag: 1f2f8a3f-e0bc-5b1e-a4b3-67a1f932af0a
        summarizeBy: none
        isDataTypeInferred: false

    partition RoleDefinitions = calculated
        mode: import
        source =
            DISTINCT(UNION(
                SELECTCOLUMNS(ActiveRoleAssignments, "RoleDefinitionId", ActiveRoleAssignments[RoleDefinitionId]),
                SELECTCOLUMNS(EligibleRoleAssignments, "RoleDefinitionId", EligibleRoleAssignments[RoleDefinitionId]),
                SELECTCOLUMNS(RoleAssignments, "RoleDefinitionId", RoleAssignments[RoleDefinitionId])
            ))

    annotation PBI_ResultType = Table
