table ReportSettings
    lineageTag: 1b852551-4fb8-4640-b4c4-4f59a1a2f0e0

    column RunDate
        dataType: dateTime
        formatString: Short Date
        lineageTag: a0c65101-a63d-4b41-bac7-53751ad8e946
        summarizeBy: none
        sourceColumn: RunDate

    column DisplayConcealedNames
        dataType: boolean
        lineageTag: 535e1228-95e3-4c3b-98f8-6e73c2cc9229
        summarizeBy: none
        sourceColumn: DisplayConcealedNames

    partition ReportSettings = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\report-settings.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                #"Changed Type" = Table.TransformColumnTypes(Cleaned, {{"RunDate", type date}, {"DisplayConcealedNames", type logical}})
            in
                #"Changed Type"

    annotation PBI_ResultType = Table
