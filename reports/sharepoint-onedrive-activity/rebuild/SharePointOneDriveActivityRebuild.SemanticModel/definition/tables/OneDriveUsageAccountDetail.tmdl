    partition OneDriveUsageAccountDetail = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\onedrive-usage-account-detail.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
