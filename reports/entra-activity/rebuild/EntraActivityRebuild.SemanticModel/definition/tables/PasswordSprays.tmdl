/// Sign-in watch (BRO-565): one row per address that failed a password (error 50126) on 10 or more accounts in the 30-day window. GotIn counts accounts whose password worked from that address (signed in, or stopped only at MFA); SignedIn those that signed in.
table PasswordSprays
    lineageTag: c6248138-9b30-56e0-91f5-4af883af0599

    column Ip
        dataType: string
        lineageTag: 3c85402a-c7a4-5f05-8f38-9b9d7333477a
        summarizeBy: none
        isNameInferred
        sourceColumn: [Ip]

    column AccountsTried
        dataType: int64
        formatString: #,0
        lineageTag: 48b83bae-5936-5d92-80ec-855a62ee4ffe
        summarizeBy: none
        isNameInferred
        sourceColumn: [AccountsTried]

    column FirstTry
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        lineageTag: bd645de6-fb6f-58d4-a4d7-d7939997d67b
        summarizeBy: none
        isNameInferred
        sourceColumn: [FirstTry]

    column LastTry
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        lineageTag: 48c45ec7-04e0-5309-8fbc-f3614bb23a19
        summarizeBy: none
        isNameInferred
        sourceColumn: [LastTry]

    column Place
        dataType: string
        lineageTag: b440d3cf-a48c-500c-a889-304a3a8b7847
        summarizeBy: none
        isNameInferred
        sourceColumn: [Place]

    column GotIn
        dataType: int64
        formatString: #,0
        lineageTag: 86e80542-923d-5c53-baea-e8fe05e31b1a
        summarizeBy: none
        isNameInferred
        sourceColumn: [GotIn]

    column SignedIn
        dataType: int64
        formatString: #,0
        lineageTag: a71771a2-7ac9-5890-975d-0cff2077a623
        summarizeBy: none
        isNameInferred
        sourceColumn: [SignedIn]

    column GotInName
        dataType: string
        lineageTag: 7f7e829e-dd19-5469-a759-3fe3ec340db7
        summarizeBy: none
        isNameInferred
        sourceColumn: [GotInName]

    column GotInAt
        dataType: dateTime
        formatString: yyyy-mm-dd hh:nn
        lineageTag: 82aa719e-d257-560d-a5de-26e19d86c2b7
        summarizeBy: none
        isNameInferred
        sourceColumn: [GotInAt]

    column FlaggedSignIns
        dataType: int64
        formatString: #,0
        lineageTag: 0574c424-a072-57ac-9097-a157e456e393
        summarizeBy: none
        isNameInferred
        sourceColumn: [FlaggedSignIns]

    partition PasswordSprays = calculated
        mode: import
        source =
            VAR vFail = UNION(SELECTCOLUMNS(FILTER(SignInsInteractive, SignInsInteractive[InWindow] && SignInsInteractive[ErrorCode] = "50126" && NOT ISBLANK(SignInsInteractive[IpAddress])), "Ip", SignInsInteractive[IpAddress], "Acct", SignInsInteractive[AccountKey], "Tm", SignInsInteractive[SignInAt], "SprayPlace", SignInsInteractive[Place]), SELECTCOLUMNS(FILTER(SignInsNonInteractive, SignInsNonInteractive[InWindow] && SignInsNonInteractive[ErrorCode] = "50126" && NOT ISBLANK(SignInsNonInteractive[IpAddress])), "Ip", SignInsNonInteractive[IpAddress], "Acct", SignInsNonInteractive[AccountKey], "Tm", SignInsNonInteractive[SignInAt], "SprayPlace", SignInsNonInteractive[Place]))
            VAR vPass = UNION(SELECTCOLUMNS(FILTER(SignInsInteractive, SignInsInteractive[InWindow] && SignInsInteractive[PasswordWorked] && NOT ISBLANK(SignInsInteractive[IpAddress])), "PassIp", SignInsInteractive[IpAddress], "PassAcct", SignInsInteractive[AccountKey], "PassName", SignInsInteractive[PersonName], "PassErr", SignInsInteractive[ErrorCode], "PassTm", SignInsInteractive[SignInAt]), SELECTCOLUMNS(FILTER(SignInsNonInteractive, SignInsNonInteractive[InWindow] && SignInsNonInteractive[PasswordWorked] && NOT ISBLANK(SignInsNonInteractive[IpAddress])), "PassIp", SignInsNonInteractive[IpAddress], "PassAcct", SignInsNonInteractive[AccountKey], "PassName", SignInsNonInteractive[PersonName], "PassErr", SignInsNonInteractive[ErrorCode], "PassTm", SignInsNonInteractive[SignInAt]))
            VAR vRisk = UNION(SELECTCOLUMNS(FILTER(SignInsInteractive, SignInsInteractive[InWindow] && NOT ISBLANK(SignInsInteractive[RiskBand]) && NOT ISBLANK(SignInsInteractive[IpAddress])), "RiskIp", SignInsInteractive[IpAddress]), SELECTCOLUMNS(FILTER(SignInsNonInteractive, SignInsNonInteractive[InWindow] && NOT ISBLANK(SignInsNonInteractive[RiskBand]) && NOT ISBLANK(SignInsNonInteractive[IpAddress])), "RiskIp", SignInsNonInteractive[IpAddress]))
            VAR vIps = DISTINCT(SELECTCOLUMNS(vFail, "Ip", [Ip]))
            VAR vTried = ADDCOLUMNS(vIps, "AccountsTried", VAR vThisIp = [Ip] RETURN COUNTROWS(DISTINCT(SELECTCOLUMNS(FILTER(vFail, [Ip] = vThisIp), "A", [Acct]))))
            VAR vSprays = FILTER(vTried, [AccountsTried] >= 10)
            VAR vFirst = ADDCOLUMNS(vSprays, "FirstTry", VAR vThisIp = [Ip] RETURN MINX(FILTER(vFail, [Ip] = vThisIp), [Tm]))
            VAR vLast = ADDCOLUMNS(vFirst, "LastTry", VAR vThisIp = [Ip] RETURN MAXX(FILTER(vFail, [Ip] = vThisIp), [Tm]))
            VAR vPlace = ADDCOLUMNS(vLast, "Place", VAR vThisIp = [Ip] RETURN CONCATENATEX(TOPN(1, FILTER(vFail, [Ip] = vThisIp && NOT ISBLANK([SprayPlace])), [Tm], ASC), [SprayPlace]))
            VAR vGot = ADDCOLUMNS(vPlace, "GotIn", VAR vThisIp = [Ip] RETURN COUNTROWS(DISTINCT(SELECTCOLUMNS(FILTER(vPass, [PassIp] = vThisIp), "A", [PassAcct]))) + 0)
            VAR vSigned = ADDCOLUMNS(vGot, "SignedIn", VAR vThisIp = [Ip] RETURN COUNTROWS(DISTINCT(SELECTCOLUMNS(FILTER(vPass, [PassIp] = vThisIp && [PassErr] = "0"), "A", [PassAcct]))) + 0)
            VAR vNamed = ADDCOLUMNS(vSigned, "GotInName", VAR vThisIp = [Ip] RETURN CONCATENATEX(TOPN(1, FILTER(vPass, [PassIp] = vThisIp), [PassTm], ASC, [PassName], ASC), [PassName]))
            VAR vWhen = ADDCOLUMNS(vNamed, "GotInAt", VAR vThisIp = [Ip] RETURN MINX(FILTER(vPass, [PassIp] = vThisIp), [PassTm]))
            RETURN ADDCOLUMNS(vWhen, "FlaggedSignIns", VAR vThisIp = [Ip] RETURN COUNTROWS(FILTER(vRisk, [RiskIp] = vThisIp)) + 0)

    annotation PBI_ResultType = Table
