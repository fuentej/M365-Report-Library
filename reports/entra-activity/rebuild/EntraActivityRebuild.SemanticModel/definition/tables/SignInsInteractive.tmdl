        dataType: string
        lineageTag: 8a2e822b-6dd1-4c6d-a8fa-91f85549f36e
        summarizeBy: none
        sourceColumn: DeviceIsManaged

    column IsInteractive
        dataType: string
        lineageTag: bbae0653-390a-4578-89a7-74b80be19dad
        summarizeBy: none
        sourceColumn: IsInteractive

    column SignInEventTypes
        dataType: string
