    partition ItemPermissions = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\item-permissions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                #"Changed Type" = Table.TransformColumnTypes(Cleaned, {{"RunDate", type date}, {"LinkPreventsDownload", type logical}, {"HasPassword", type logical}, {"IsInherited", type logical}})
            in
                #"Changed Type"

    annotation PBI_ResultType = Table
