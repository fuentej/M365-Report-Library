{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "ovTrend",
  "position": {
    "x": 0.0,
    "y": 200.0,
    "z": 3,
    "width": 640.0,
    "height": 520.0,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Calendar.Date",
              "nativeQueryRef": "Calendar.Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Total Events"
                }
              },
              "queryRef": "Measures.[Total Events]",
              "nativeQueryRef": "Measures.[Total Events]"
            }
          ]
        }
      }
    }
  }
}
