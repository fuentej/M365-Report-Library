expression CsvFolder = "samples" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 10c6689a-9a4e-43ba-9069-94fbfc3b74b8
	queryGroup: Parameters

/// UTC clock time from the CSV's yyyy-MM-ddTHH:mm:ssZ text. RemoveZone keeps
/// the UTC components; DateTime.From would convert a zoned value to local time.
expression ParseUtcDateTime =
				(value as any) as nullable datetime =>
					let
					    textValue = if value = null then null else Text.From(value)
					in
					    if textValue = null or textValue = "" then
					        null
					    else
					        DateTimeZone.RemoveZone(
					            DateTimeZone.FromText(
					                textValue,
					                [Format="yyyy-MM-dd'T'HH:mm:ss'Z'", Culture="en-US"]
					            )
					        )
	lineageTag: 6f0a1c2e-4b7d-4e1a-9c33-0a1b2c3d4e5f

/// yyyy-MM-dd date, or null when the cell is blank. Date.From rejects "".
expression ParseOptionalDate =
				(value as any) as nullable date =>
					let
					    textValue = if value = null then null else Text.From(value)
					in
					    if textValue = null or textValue = "" then
					        null
					    else
					        Date.FromText(textValue, [Format="yyyy-MM-dd", Culture="en-US"])
	lineageTag: 7a1b2c3d-5e6f-4a80-8d21-1b2c3d4e5f60

/// Whole number, or null when the cell is blank. Int64.From rejects "".
expression ParseOptionalInt64 =
				(value as any) as nullable number =>
					if value = null or value = "" then
						null
					else
						Int64.From(value)
	lineageTag: 8b2c3d4e-6f70-4b91-9e32-2c3d4e5f6071

queryGroup Parameters
	annotation PBI_QueryGroupOrder = 0
