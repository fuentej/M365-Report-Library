/// Content Explorer rows whose TagType is Sensitivity. Label coverage
/// reads this table so retention and sensitive-info-type counts are not
/// mixed into the sensitivity trend.
table SensitivityAtRest

	column SnapshotDate
		dataType: dateTime
		formatString: Long Date
		sourceColumn: SnapshotDate
		summarizeBy: none

	column TagName
		dataType: string
		sourceColumn: TagName
		summarizeBy: none

	column Workload
		dataType: string
		sourceColumn: Workload
		summarizeBy: none

	column TotalCount
		dataType: int64
		sourceColumn: TotalCount
		summarizeBy: sum

	/// Labels[Priority] of the label this row counts. Get-ContentExplorerSnapshot
	/// writes the label's Name (not its DisplayName) as TagName, so match on Name.
	column 'Label Priority' = MAXX(FILTER(Labels, Labels[Name] = SensitivityAtRest[TagName]), Labels[Priority])
		dataType: int64
		type: calculated
		isHidden
		summarizeBy: none

	/// Display name of the label this row counts, for chart legends. Falls back
	/// to TagName for a label that is no longer in policies.csv.
	column 'Label Name' = COALESCE(MAXX(FILTER(Labels, Labels[Name] = SensitivityAtRest[TagName]), Labels[DisplayName]), SensitivityAtRest[TagName])
		dataType: string
		type: calculated
		summarizeBy: none

	/// Snapshot date as the chart's axis label ("Jul 1").
	column 'Snapshot Label' = FORMAT(SensitivityAtRest[SnapshotDate], "mmm d")
		dataType: string
		type: calculated
		summarizeBy: none
		sortByColumn: SnapshotDate

	partition SensitivityAtRest = m
		mode: import
		source =
				let
				    Source = ContentExplorerSnapshot,
				    Filtered = Table.SelectRows(Source, each [TagType] = "Sensitivity"),
				    Kept = Table.SelectColumns(Filtered, {"RunDate", "TagName", "Workload", "TotalCount"}),
				    Renamed = Table.RenameColumns(Kept, {{"RunDate", "SnapshotDate"}})
				in
				    Renamed
