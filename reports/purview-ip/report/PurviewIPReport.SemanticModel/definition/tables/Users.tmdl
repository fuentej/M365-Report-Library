/// The tenant's user directory (shared Entra users collector / users.csv). One row per
/// user, plus the manager-chain hierarchy built from ManagerId with PATH()
/// and the anonymize-toggle pseudonym used by the report's anonymize slicer.
table Users

	column RunDate
		dataType: dateTime
		formatString: Long Date
		sourceColumn: RunDate
		summarizeBy: none

	column UserId
		dataType: string
		sourceColumn: Id
		summarizeBy: none

	column DisplayName
		dataType: string
		sourceColumn: DisplayName
		summarizeBy: none

	column UserPrincipalName
		dataType: string
		sourceColumn: UserPrincipalName
		summarizeBy: none

	column Mail
		dataType: string
		sourceColumn: Mail
		summarizeBy: none

	column UserType
		dataType: string
		sourceColumn: UserType
		summarizeBy: none

	column AccountEnabled
		dataType: string
		sourceColumn: AccountEnabled
		summarizeBy: none

	column CreatedDateTime
		dataType: dateTime
		formatString: General Date
		sourceColumn: CreatedDateTime
		summarizeBy: none

	column Department
		dataType: string
		sourceColumn: Department
		summarizeBy: none

	column JobTitle
		dataType: string
		sourceColumn: JobTitle
		summarizeBy: none

	column City
		dataType: string
		sourceColumn: City
		summarizeBy: none

	column Country
		dataType: string
		sourceColumn: Country
		summarizeBy: none

	column ManagerId
		dataType: string
		sourceColumn: ManagerId
		summarizeBy: none

	column ManagerUserPrincipalName
		dataType: string
		sourceColumn: ManagerUserPrincipalName
		summarizeBy: none

	/// Manager chain from the top of the org down to this user, UserIds joined
	/// with "|" (the same text DAX PATH() returns). This column, the Level
	/// columns and the pseudonyms are all built in the Users query below, not
	/// as DAX calculated columns. 'User Display' has a relationship to Users,
	/// which gives Users a blank row; DAX columns that scan Users (PATH, RANKX,
	/// LOOKUPVALUE) depend on that blank row, and 'User Display' reads them, so
	/// Power BI Desktop refused the refresh with a circular dependency.
	column 'Manager Path'
		dataType: string
		isHidden
		sourceColumn: Manager Path
		summarizeBy: none

	column 'Manager Path Length'
		dataType: int64
		isHidden
		sourceColumn: Manager Path Length
		summarizeBy: none

	column 'Level 1 Id'
		dataType: string
		isHidden
		sourceColumn: Level 1 Id
		summarizeBy: none

	column 'Level 2 Id'
		dataType: string
		isHidden
		sourceColumn: Level 2 Id
		summarizeBy: none

	column 'Level 3 Id'
		dataType: string
		isHidden
		sourceColumn: Level 3 Id
		summarizeBy: none

	column 'Level 4 Id'
		dataType: string
		isHidden
		sourceColumn: Level 4 Id
		summarizeBy: none

	column 'Level 5 Id'
		dataType: string
		isHidden
		sourceColumn: Level 5 Id
		summarizeBy: none

	column 'Level 1 Name'
		dataType: string
		sourceColumn: Level 1 Name
		summarizeBy: none

	column 'Level 2 Name'
		dataType: string
		sourceColumn: Level 2 Name
		summarizeBy: none

	column 'Level 3 Name'
		dataType: string
		sourceColumn: Level 3 Name
		summarizeBy: none

	column 'Level 4 Name'
		dataType: string
		sourceColumn: Level 4 Name
		summarizeBy: none

	column 'Level 5 Name'
		dataType: string
		sourceColumn: Level 5 Name
		summarizeBy: none

	/// Stable per-user pseudonym number: the user's position in UserId order, so
	/// the same user always gets the same "User 00001"-style label while the data
	/// is unchanged. Used by the [Display Name] measure when the report-wide
	/// anonymize toggle is on.
	column 'Anonymous Id'
		dataType: int64
		isHidden
		sourceColumn: Anonymous Id
		summarizeBy: none

	column 'Anonymous Display Name'
		dataType: string
		sourceColumn: Anonymous Display Name
		summarizeBy: none

	column 'Level 1 Anonymous Name'
		dataType: string
		isHidden
		sourceColumn: Level 1 Anonymous Name
		summarizeBy: none

	column 'Level 2 Anonymous Name'
		dataType: string
		isHidden
		sourceColumn: Level 2 Anonymous Name
		summarizeBy: none

	column 'Level 3 Anonymous Name'
		dataType: string
		isHidden
		sourceColumn: Level 3 Anonymous Name
		summarizeBy: none

	column 'Level 4 Anonymous Name'
		dataType: string
		isHidden
		sourceColumn: Level 4 Anonymous Name
		summarizeBy: none

	column 'Level 5 Anonymous Name'
		dataType: string
		isHidden
		sourceColumn: Level 5 Anonymous Name
		summarizeBy: none

	hierarchy 'Manager Chain'
		level 'Level 1'
			column: 'Level 1 Name'
		level 'Level 2'
			column: 'Level 2 Name'
		level 'Level 3'
			column: 'Level 3 Name'
		level 'Level 4'
			column: 'Level 4 Name'
		level 'Level 5'
			column: 'Level 5 Name'

	partition Users = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "\users.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders, {
				        {"Id", type text}, {"DisplayName", type text}, {"UserPrincipalName", type text},
				        {"Mail", type text}, {"UserType", type text}, {"AccountEnabled", type text},
				        {"Department", type text}, {"JobTitle", type text}, {"City", type text}, {"Country", type text},
				        {"ManagerId", type text}, {"ManagerUserPrincipalName", type text}
				    }),
				    ParsedRun = Table.TransformColumns(ChangedType, {
				        {"RunDate", each ParseOptionalDate(_), type date}
				    }),
				    ParsedUtc = Table.TransformColumns(ParsedRun, {
				        {"CreatedDateTime", each ParseUtcDateTime(_), type datetime}
				    }),
				    Current = KeepLatestRunDate(ParsedUtc),
				    SortedById = Table.Sort(Current, {{"Id", Order.Ascending}}),
				    Numbered = Table.AddIndexColumn(SortedById, "Anonymous Id", 1, 1, Int64.Type),
				    // Lookups by UserId. Rows with no Id can't be anyone's manager.
				    Keyed = Table.SelectRows(Numbered, each [Id] <> null and [Id] <> ""),
				    KeyIds = Table.Column(Keyed, "Id"),
				    ManagerOf = Record.FromList(Table.Column(Keyed, "ManagerId"), KeyIds),
				    NameOf = Record.FromList(Table.Column(Keyed, "DisplayName"), KeyIds),
				    AnonymousNameOf = Record.FromList(
				        List.Transform(Table.Column(Keyed, "Anonymous Id"), each "User " & Text.PadStart(Text.From(_), 5, "0")),
				        KeyIds),
				    // This user, then their manager, and so on up. Stops at a manager who is
				    // not in the file or who is already in the chain (a reporting loop).
				    ChainUp = (id) => List.Generate(
				        () => [Cur = id, Seen = {}],
				        each [Cur] <> null and [Cur] <> "" and Record.HasFields(ManagerOf, [Cur]) and not List.Contains([Seen], [Cur]),
				        each [Cur = Record.Field(ManagerOf, [Cur]), Seen = [Seen] & {[Cur]}],
				        each [Cur]),
				    WithChain = Table.AddColumn(Numbered, "Chain", each List.Reverse(ChainUp([Id]))),
				    LevelId = (chain as list, n as number) => if List.Count(chain) >= n then chain{n - 1} else null,
				    NameAt = (names as record, chain as list, n as number) =>
				        let id = LevelId(chain, n) in if id = null then null else Record.FieldOrDefault(names, id, null),
				    WithPath = Table.AddColumn(WithChain, "Manager Path", each if List.IsEmpty([Chain]) then null else Text.Combine([Chain], "|"), type text),
				    WithLength = Table.AddColumn(WithPath, "Manager Path Length", each List.Count([Chain]), Int64.Type),
				    WithLevelIds = List.Accumulate({1..5}, WithLength, (tbl, n) =>
				        Table.AddColumn(tbl, "Level " & Text.From(n) & " Id", each LevelId([Chain], n), type text)),
				    WithLevelNames = List.Accumulate({1..5}, WithLevelIds, (tbl, n) =>
				        Table.AddColumn(tbl, "Level " & Text.From(n) & " Name",
				            each NameAt(NameOf, [Chain], n), type text)),
				    WithAnonymousName = Table.AddColumn(WithLevelNames, "Anonymous Display Name",
				        each "User " & Text.PadStart(Text.From([Anonymous Id]), 5, "0"), type text),
				    WithAnonymousLevels = List.Accumulate({1..5}, WithAnonymousName, (tbl, n) =>
				        Table.AddColumn(tbl, "Level " & Text.From(n) & " Anonymous Name",
				            each NameAt(AnonymousNameOf, [Chain], n), type text)),
				    Result = Table.RemoveColumns(WithAnonymousLevels, {"Chain"})
				in
				    Result
