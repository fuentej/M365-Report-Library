/// Report-wide DAX measures, collected in one unrelated table (the common
/// "measures table" pattern) rather than scattered across the fact tables
/// they read from, since several of them (downgrade detection, the
/// anonymize switch) cross more than one table.
table _Measures

	column 'Measures Key'
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Measures Key]

	measure 'Total Events' = COUNTROWS(ActivityExplorerEvents)
		formatString: #,##0
		displayFolder: Overview

	measure 'Total Users' = COUNTROWS(Users)
		formatString: #,##0
		displayFolder: Overview

	measure 'Total Copilot Interactions' = DISTINCTCOUNT(CopilotAccessedResources[RecordId])
		formatString: #,##0
		displayFolder: Overview

	measure 'Total Copilot Resource Rows' = COUNTROWS(CopilotAccessedResources)
		formatString: #,##0
		displayFolder: Copilot and AI
		isHidden

	measure 'Items At Rest' = SUM(ContentExplorerSnapshot[TotalCount])
		formatString: #,##0
		displayFolder: Label coverage
		isHidden

	measure 'Sensitivity Items At Rest' = SUM(SensitivityAtRest[TotalCount])
		formatString: #,##0
		displayFolder: Label coverage

	measure 'Latest Sensitivity Snapshot Date' = MAX(SensitivityAtRest[SnapshotDate])
		formatString: Long Date
		displayFolder: Label coverage
		isHidden

	measure 'Sensitivity Items At Rest (Latest)' =
			VAR LatestDate = [Latest Sensitivity Snapshot Date]
			RETURN
			    CALCULATE([Sensitivity Items At Rest], SensitivityAtRest[SnapshotDate] = LatestDate)
		formatString: #,##0
		displayFolder: Label coverage

	measure 'Retention Items At Rest' = SUM(RetentionAtRest[TotalCount])
		formatString: #,##0
		displayFolder: Retention

	measure 'Latest Retention Snapshot Date' = MAX(RetentionAtRest[SnapshotDate])
		formatString: Long Date
		displayFolder: Retention
		isHidden

	measure 'Retention Items At Rest (Latest)' =
			VAR LatestDate = [Latest Retention Snapshot Date]
			RETURN
			    CALCULATE([Retention Items At Rest], RetentionAtRest[SnapshotDate] = LatestDate)
		formatString: #,##0
		displayFolder: Retention

	measure 'Label Applications' = CALCULATE([Total Events], ActivityExplorerEvents[LabelEventType] = "LabelApplied")
		formatString: #,##0
		displayFolder: Label activity

	measure 'Label Removals' = CALCULATE([Total Events], ActivityExplorerEvents[LabelEventType] = "LabelRemoved")
		formatString: #,##0
		displayFolder: Label activity

	measure 'Label Upgrades' = CALCULATE([Total Events], ActivityExplorerEvents[LabelEventType] = "LabelUpgraded")
		formatString: #,##0
		displayFolder: Label activity

	/// The source's own LabelEventType already distinguishes "LabelDowngraded"
	/// from "LabelUpgraded" (Get-ActivityExplorerEvents.ps1 sets
	/// IsLabelDowngrade from the portal's LabelEventType). This measure does
	/// not trust that pre-classification: it independently walks
	/// Labels[Priority] - the label priority field from policies.csv - and
	/// counts an event as a downgrade only when the new label's priority is
	/// lower than the old label's, per Purview's convention that priority
	/// increases with sensitivity (see samples/policies.csv: Public=0 ...
	/// Restricted=6).
	measure 'Label Downgrades' =
			CALCULATE(
			    [Total Events],
			    FILTER(
			        ActivityExplorerEvents,
			        ActivityExplorerEvents[OldSensitivityLabel] <> ""
			            && ActivityExplorerEvents[SensitivityLabel] <> ""
			            && LOOKUPVALUE(Labels[Priority], Labels[ObjectId], ActivityExplorerEvents[SensitivityLabel])
			                < LOOKUPVALUE(Labels[Priority], Labels[ObjectId], ActivityExplorerEvents[OldSensitivityLabel])
			    )
			)
		formatString: #,##0
		displayFolder: Label activity

	measure 'Label Changes' = [Label Upgrades] + [Label Downgrades]
		formatString: #,##0
		displayFolder: Label activity

	measure 'DLP Matches' = CALCULATE([Total Events], ActivityExplorerEvents[Activity] = "DLPRuleMatch")
		formatString: #,##0
		displayFolder: DLP

	measure 'DLP Enforcements' = CALCULATE([Total Events], ActivityExplorerEvents[Activity] = "DLPRuleEnforce")
		formatString: #,##0
		displayFolder: DLP

	measure 'DLP Overrides' = CALCULATE([Total Events], ActivityExplorerEvents[Activity] = "DLPRuleUndo")
		formatString: #,##0
		displayFolder: DLP

	measure 'DLP Overrides With Justification' = CALCULATE([DLP Overrides], ActivityExplorerEvents[Justification] <> "")
		formatString: #,##0
		displayFolder: DLP

	measure 'Retention Label Changes' = CALCULATE([Total Events], ActivityExplorerEvents[ActivityCategory] = "Retention")
		formatString: #,##0
		displayFolder: Retention

	measure 'Copilot Resources Accessed' = CALCULATE([Total Copilot Resource Rows], CopilotAccessedResources[ResourceId] <> "")
		formatString: #,##0
		displayFolder: Copilot and AI

	measure 'Copilot Access Blocked' = CALCULATE([Total Copilot Resource Rows], CopilotAccessedResources[AccessBlocked] = "True")
		formatString: #,##0
		displayFolder: Copilot and AI

	measure 'Copilot Access Allowed' = CALCULATE([Total Copilot Resource Rows], CopilotAccessedResources[AccessBlocked] = "False")
		formatString: #,##0
		displayFolder: Copilot and AI

	measure 'Copilot DLP Matches' = CALCULATE([Total Copilot Resource Rows], CopilotAccessedResources[PolicyId] <> "")
		formatString: #,##0
		displayFolder: Copilot and AI

	measure 'Policy Object Count' = COUNTROWS(Policies)
		formatString: #,##0
		displayFolder: Policy posture

	measure 'Sensitivity Label Count' = COUNTROWS(Labels)
		formatString: #,##0
		displayFolder: Policy posture

	measure 'DLP Policy Count' = CALCULATE([Policy Object Count], Policies[ObjectType] = "DlpPolicy")
		formatString: #,##0
		displayFolder: Policy posture

	measure 'DLP Rule Count' = CALCULATE([Policy Object Count], Policies[ObjectType] = "DlpRule")
		formatString: #,##0
		displayFolder: Policy posture

	measure 'Auto-Labeling Policy Count' = CALCULATE([Policy Object Count], Policies[ObjectType] = "AutoLabelingPolicy")
		formatString: #,##0
		displayFolder: Policy posture

	measure 'Retention Policy Count' = CALCULATE([Policy Object Count], Policies[ObjectType] = "RetentionPolicy")
		formatString: #,##0
		displayFolder: Policy posture

	measure 'Retention Label Count' = COUNTROWS(RetentionLabels)
		formatString: #,##0
		displayFolder: Policy posture

	measure 'Copilot-Scoped DLP Policies' = CALCULATE([DLP Policy Count], Policies[AppliesToCopilot] = "True")
		formatString: #,##0
		displayFolder: Policy posture

	/// The generated What-If parameter value (0 = off, 1 = on).
	measure 'Anonymize Toggle Value' = SELECTEDVALUE('Anonymize Toggle'[Anonymize Toggle], 0)
		formatString: 0
		displayFolder: Anonymize
		isHidden

	/// The measure every page's user-level visuals show instead of
	/// Users[DisplayName] directly, so the anonymize slicer can swap it for
	/// the stable pseudonym in Users[Anonymous Display Name] without any
	/// per-page bookmark.
	measure 'Display Name' =
			IF(
			    [Anonymize Toggle Value] = 1,
			    SELECTEDVALUE(Users[Anonymous Display Name]),
			    SELECTEDVALUE(Users[DisplayName])
			)
		displayFolder: Anonymize

	/// BRO-502 page "Label downgrades". The top label is the sensitivity label
	/// with the highest Priority in policies.csv (Restricted in the samples).
	/// Display name of that label.
	measure 'Top Label Name' =
			VAR TopPriority = CALCULATE(MAX(Labels[Priority]), ALL(Labels))
			RETURN
			    MAXX(FILTER(ALL(Labels), Labels[Priority] = TopPriority), Labels[DisplayName])
		displayFolder: Label downgrades

	/// Events that took the top label off an item: changed it to a
	/// lower-priority label or removed it (ActivityExplorerEvents[Top Label Downgrade]).
	measure 'Top Label Downgrades' = CALCULATE(COUNTROWS(ActivityExplorerEvents), ActivityExplorerEvents[Top Label Downgrade] = 1) + 0
		formatString: #,##0
		displayFolder: Label downgrades

	measure 'Top Label Downgraders' = CALCULATE(DISTINCTCOUNT(ActivityExplorerEvents[User]), ActivityExplorerEvents[Top Label Downgrade] = 1) + 0
		formatString: #,##0
		displayFolder: Label downgrades

	/// Different non-blank justifications typed on top-label downgrades.
	measure 'Top Label Downgrade Reasons' =
			CALCULATE(
			    DISTINCTCOUNT(ActivityExplorerEvents[Justification]),
			    ActivityExplorerEvents[Top Label Downgrade] = 1,
			    ActivityExplorerEvents[Justification] <> ""
			) + 0
		formatString: #,##0
		displayFolder: Label downgrades

	measure 'Top Label Downgrades Without Reason' =
			CALCULATE(
			    COUNTROWS(ActivityExplorerEvents),
			    ActivityExplorerEvents[Top Label Downgrade] = 1,
			    ActivityExplorerEvents[Justification] = ""
			) + 0
		formatString: #,##0
		displayFolder: Label downgrades
		isHidden

	/// Name of the top label as Content Explorer records it: the snapshot
	/// collector writes Get-Label Name, not DisplayName, as SensitivityAtRest[TagName].
	measure 'Top Label Tag Name' =
			VAR TopPriority = CALCULATE(MAX(Labels[Priority]), ALL(Labels))
			RETURN
			    MAXX(FILTER(ALL(Labels), Labels[Priority] = TopPriority), Labels[Name])
		displayFolder: Label downgrades
		isHidden

	/// FirstDate and LastDate are DAX functions, so the variables are named
	/// EarliestSnapshot and LatestSnapshot.
	measure 'Top Label Items First' =
			VAR TopName = [Top Label Tag Name]
			VAR EarliestSnapshot = CALCULATE(MIN(SensitivityAtRest[SnapshotDate]), ALL(SensitivityAtRest))
			RETURN
			    CALCULATE(
			        SUM(SensitivityAtRest[TotalCount]),
			        ALL(SensitivityAtRest),
			        SensitivityAtRest[TagName] = TopName,
			        SensitivityAtRest[SnapshotDate] = EarliestSnapshot
			    )
		formatString: #,##0
		displayFolder: Label downgrades
		isHidden

	measure 'Top Label Items Latest' =
			VAR TopName = [Top Label Tag Name]
			VAR LatestSnapshot = CALCULATE(MAX(SensitivityAtRest[SnapshotDate]), ALL(SensitivityAtRest))
			RETURN
			    CALCULATE(
			        SUM(SensitivityAtRest[TotalCount]),
			        ALL(SensitivityAtRest),
			        SensitivityAtRest[TagName] = TopName,
			        SensitivityAtRest[SnapshotDate] = LatestSnapshot
			    )
		formatString: #,##0
		displayFolder: Label downgrades
		isHidden

	/// Change in items carrying the top label between the first and the
	/// latest Content Explorer snapshot.
	measure 'Top Label Items Change' =
			VAR FirstItems = [Top Label Items First]
			RETURN
			    DIVIDE([Top Label Items Latest] - FirstItems, FirstItems)
		formatString: +0%;-0%;0%
		displayFolder: Label downgrades

	/// Items at rest for the two highest-priority labels only; blank for every other label.
	measure 'Top Label Items At Rest' =
			VAR TopPriority = CALCULATE(MAX(Labels[Priority]), ALL(Labels))
			VAR LabelPriority = MAX(SensitivityAtRest[Label Priority])
			RETURN
			    IF(
			        NOT ISBLANK(LabelPriority) && LabelPriority >= TopPriority - 1,
			        SUM(SensitivityAtRest[TotalCount])
			    )
		formatString: #,##0
		displayFolder: Label downgrades

	measure 'Top Reason Uses' =
			VAR Reasons =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(ActivityExplorerEvents[Justification]),
			            ActivityExplorerEvents[Top Label Downgrade] = 1,
			            ActivityExplorerEvents[Justification] <> ""
			        ),
			        "@Uses", CALCULATE(COUNTROWS(ActivityExplorerEvents), ActivityExplorerEvents[Top Label Downgrade] = 1)
			    )
			RETURN
			    MAXX(Reasons, [@Uses]) + 0
		formatString: #,##0
		displayFolder: Label downgrades
		isHidden

	/// The justification typed most often on top-label downgrades, in quotes.
	measure 'Top Reason' =
			VAR Reasons =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(ActivityExplorerEvents[Justification]),
			            ActivityExplorerEvents[Top Label Downgrade] = 1,
			            ActivityExplorerEvents[Justification] <> ""
			        ),
			        "@Uses", CALCULATE(COUNTROWS(ActivityExplorerEvents), ActivityExplorerEvents[Top Label Downgrade] = 1)
			    )
			VAR TopReason = TOPN(1, Reasons, [@Uses], DESC, ActivityExplorerEvents[Justification], ASC)
			RETURN
			    IF(
			        ISEMPTY(Reasons),
			        "No reason typed",
			        """" & MAXX(TopReason, ActivityExplorerEvents[Justification]) & """"
			    )
		displayFolder: Label downgrades

	/// Text: the multiplication sign and how many downgrades gave the top reason.
	measure 'Top Reason Count' = UNICHAR(215) & [Top Reason Uses]
		displayFolder: Label downgrades

	measure 'Top Reason Detail' =
			VAR Reasons =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(ActivityExplorerEvents[Justification]),
			            ActivityExplorerEvents[Top Label Downgrade] = 1,
			            ActivityExplorerEvents[Justification] <> ""
			        ),
			        "@Uses", CALCULATE(COUNTROWS(ActivityExplorerEvents), ActivityExplorerEvents[Top Label Downgrade] = 1)
			    )
			VAR TopReason = TOPN(1, Reasons, [@Uses], DESC, ActivityExplorerEvents[Justification], ASC)
			VAR TopText = MAXX(TopReason, ActivityExplorerEvents[Justification])
			VAR People =
			    CALCULATE(
			        DISTINCTCOUNT(ActivityExplorerEvents[User]),
			        ActivityExplorerEvents[Top Label Downgrade] = 1,
			        ActivityExplorerEvents[Justification] = TopText
			    ) + 0
			RETURN
			    [Top Reason Uses] & " of " & [Top Label Downgrades] & " downgrades, "
			        & People & IF(People = 1, " person", " people")
		displayFolder: Label downgrades

	measure 'Excuse Wall Subtitle' = "reasons typed to remove " & [Top Label Name]
		displayFolder: Label downgrades

	/// Workloads where the top label came off, with counts, most first.
	measure 'Top Label Downgrade Places' =
			VAR Places =
			    FILTER(
			        ADDCOLUMNS(VALUES(Workload[Workload]), "@Count", [Top Label Downgrades]),
			        [@Count] > 0
			    )
			RETURN
			    IF(
			        ISEMPTY(Places),
			        "No downgrades",
			        CONCATENATEX(Places, Workload[Workload] & " " & [@Count], " " & UNICHAR(183) & " ", [@Count], DESC, Workload[Workload], ASC)
			    )
		displayFolder: Label downgrades

	measure 'Label Downgrades Run Header' =
			VAR FirstEvent = CALCULATE(MIN(ActivityExplorerEvents[EventDate]), ALL(ActivityExplorerEvents))
			VAR LastEvent = CALCULATE(MAX(ActivityExplorerEvents[EventDate]), ALL(ActivityExplorerEvents))
			VAR Snapshots = CALCULATE(DISTINCTCOUNT(ContentExplorerSnapshot[SnapshotDate]), ALL(ContentExplorerSnapshot))
			VAR FirstSnapshot = CALCULATE(MIN(ContentExplorerSnapshot[SnapshotDate]), ALL(ContentExplorerSnapshot))
			RETURN
			    "Events " & FORMAT(FirstEvent, "yyyy-mm-dd") & " to " & FORMAT(LastEvent, "yyyy-mm-dd")
			        & " " & UNICHAR(183) & " " & Snapshots & IF(Snapshots = 1, " content snapshot", " content snapshots")
			        & " since " & FORMAT(FirstSnapshot, "yyyy-mm-dd")
		displayFolder: Label downgrades

	measure 'Top Label Trend Caption' =
			VAR TopName = [Top Label Name]
			VAR FirstItems = [Top Label Items First]
			VAR LastItems = [Top Label Items Latest]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(FirstItems) || ISBLANK(LastItems), "No Content Explorer counts for " & TopName & ".",
			        LastItems > FirstItems && [Top Label Downgrades] > 0,
			            TopName & " items grew from " & FORMAT(FirstItems, "#,##0") & " to " & FORMAT(LastItems, "#,##0")
			                & " while people kept stripping the label off. The label is spreading faster than it is being respected.",
			        LastItems > FirstItems,
			            TopName & " items grew from " & FORMAT(FirstItems, "#,##0") & " to " & FORMAT(LastItems, "#,##0") & ".",
			        TopName & " items went from " & FORMAT(FirstItems, "#,##0") & " to " & FORMAT(LastItems, "#,##0") & "."
			    )
		displayFolder: Label downgrades

	measure 'Label Downgrades One Fix Title' = "Stop free-text downgrades on " & [Top Label Name]
		displayFolder: Label downgrades

	/// Lead is a DAX function, so the variable is named Opening.
	measure 'Label Downgrades One Fix Detail' =
			VAR Reasons = [Top Label Downgrade Reasons]
			VAR NoReason = [Top Label Downgrades Without Reason]
			VAR Opening =
			    SWITCH(
			        TRUE(),
			        [Top Label Downgrades] = 0, "No one has taken the label off yet.",
			        Reasons = 1 && NoReason = 0, "Every reason given is the same sentence.",
			        NoReason > 0 && Reasons = 0, "No downgrade gave a reason.",
			        NoReason > 0,
			            NoReason & " of " & [Top Label Downgrades] & " downgrades gave no reason; the rest used "
			                & Reasons & IF(Reasons = 1, " sentence.", " stock sentences."),
			        "The reasons come from " & Reasons & " stock sentences."
			    )
			RETURN
			    Opening & " A justification nobody reads is not a control."
		displayFolder: Label downgrades

	/// "sample data, example.com" appears only when users.csv holds @example.com accounts.
	measure 'Label Downgrades Sources' =
			VAR SampleUsers = CALCULATE(COUNTROWS(Users), ALL(Users), RIGHT(Users[UserPrincipalName], 12) = "@example.com")
			RETURN
			    "Sources: activity-explorer-events.csv " & UNICHAR(183) & " content-explorer-snapshot.csv " & UNICHAR(183) & " policies.csv"
			        & IF(SampleUsers > 0, " " & UNICHAR(183) & " sample data, example.com")
		displayFolder: Label downgrades

	/// Who took the top label off, for one event row. Honours the anonymize filter.
	measure 'Downgrade Person' =
			VAR Upn = SELECTEDVALUE(ActivityExplorerEvents[User])
			VAR RealName = MAXX(FILTER(ALL(Users), Users[UserPrincipalName] = Upn), Users[DisplayName])
			VAR Pseudonym = MAXX(FILTER(ALL(Users), Users[UserPrincipalName] = Upn), Users[Anonymous Display Name])
			RETURN
			    IF(
			        [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			        IF(
			            [Anonymize Toggle Value] = 1,
			            COALESCE(Pseudonym, "Unknown user"),
			            COALESCE(RealName, Upn)
			        )
			    )
		displayFolder: Label downgrades

	measure 'Downgrade File' =
			IF(
			    [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			    SELECTEDVALUE(ActivityExplorerEvents[ItemName])
			)
		displayFolder: Label downgrades

	measure 'Downgrade Date' =
			IF(
			    [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			    FORMAT(SELECTEDVALUE(ActivityExplorerEvents[EventDate]), "yyyy-mm-dd")
			)
		displayFolder: Label downgrades

	measure 'Downgrade Where' =
			IF(
			    [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			    SELECTEDVALUE(ActivityExplorerEvents[Workload])
			)
		displayFolder: Label downgrades

	measure 'Downgrade From Label' =
			VAR OldId = SELECTEDVALUE(ActivityExplorerEvents[OldSensitivityLabel])
			RETURN
			    IF(
			        [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			        MAXX(FILTER(ALL(Labels), Labels[ObjectId] = OldId), Labels[DisplayName])
			    )
		displayFolder: Label downgrades

	measure 'Downgrade To Label' =
			VAR NewId = SELECTEDVALUE(ActivityExplorerEvents[SensitivityLabel])
			VAR NewName = MAXX(FILTER(ALL(Labels), Labels[ObjectId] = NewId), Labels[DisplayName])
			RETURN
			    IF(
			        [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			        UNICHAR(8594) & "  " & COALESCE(NewName, "No label")
			    )
		displayFolder: Label downgrades

	/// USB COPY or DLP HIT when the same person later copied a file to
	/// removable media or hit a DLP rule within the event window. At is a DAX
	/// keyword, so the variable is named DowngradedAt.
	measure 'Downgrade Next Tag' =
			VAR Upn = SELECTEDVALUE(ActivityExplorerEvents[User])
			VAR DowngradedAt = SELECTEDVALUE(ActivityExplorerEvents[Happened])
			VAR Later =
			    FILTER(
			        ALL(ActivityExplorerEvents),
			        ActivityExplorerEvents[User] = Upn && ActivityExplorerEvents[Happened] > DowngradedAt
			    )
			VAR Risky =
			    FILTER(
			        Later,
			        ActivityExplorerEvents[Activity] IN { "FileCopiedToRemovableMedia", "DLPRuleMatch", "DLPRuleEnforce", "DLPRuleUndo" }
			    )
			VAR FirstRisky = TOPN(1, Risky, ActivityExplorerEvents[Happened], ASC, ActivityExplorerEvents[Activity], ASC)
			VAR RiskyActivity = MAXX(FirstRisky, ActivityExplorerEvents[Activity])
			RETURN
			    IF(
			        [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			        SWITCH(
			            TRUE(),
			            ISBLANK(RiskyActivity), "",
			            RiskyActivity = "FileCopiedToRemovableMedia", "USB COPY",
			            "DLP HIT"
			        )
			    )
		displayFolder: Label downgrades

	/// What the same person did next, on any file, within the event window.
	/// A USB copy or DLP hit is shown before any other later event.
	measure 'Downgrade Next Activity' =
			VAR Upn = SELECTEDVALUE(ActivityExplorerEvents[User])
			VAR DowngradedAt = SELECTEDVALUE(ActivityExplorerEvents[Happened])
			VAR RiskySet = { "FileCopiedToRemovableMedia", "DLPRuleMatch", "DLPRuleEnforce", "DLPRuleUndo" }
			VAR Later =
			    FILTER(
			        ALL(ActivityExplorerEvents),
			        ActivityExplorerEvents[User] = Upn && ActivityExplorerEvents[Happened] > DowngradedAt
			    )
			VAR HasRisky = NOT ISEMPTY(FILTER(Later, ActivityExplorerEvents[Activity] IN RiskySet))
			VAR Pool = FILTER(Later, NOT HasRisky || ActivityExplorerEvents[Activity] IN RiskySet)
			VAR Chosen = TOPN(1, Pool, ActivityExplorerEvents[Happened], ASC, ActivityExplorerEvents[Activity], ASC)
			VAR ChosenActivity = MAXX(Chosen, ActivityExplorerEvents[Activity])
			VAR ChosenItem = MAXX(Chosen, ActivityExplorerEvents[ItemName])
			VAR ChosenPolicy = MAXX(Chosen, ActivityExplorerEvents[PolicyName])
			VAR ChosenDate = FORMAT(MAXX(Chosen, ActivityExplorerEvents[EventDate]), "yyyy-mm-dd")
			VAR OtherEvents = COUNTROWS(Later) - 1
			VAR Described =
			    SWITCH(
			        ChosenActivity,
			        "FileCopiedToRemovableMedia", "Copied " & ChosenItem & " to removable media on " & ChosenDate,
			        "DLPRuleMatch", "Matched " & ChosenPolicy & " on " & ChosenItem & " on " & ChosenDate,
			        "DLPRuleEnforce", "Blocked by " & ChosenPolicy & " on " & ChosenItem & " on " & ChosenDate,
			        "DLPRuleUndo", "Overrode " & ChosenPolicy & " on " & ChosenItem & " on " & ChosenDate,
			        "ClassificationAdded", "Classified " & ChosenItem & " on " & ChosenDate,
			        "NewProtection", "Applied protection to " & ChosenItem & " on " & ChosenDate,
			        "LabelApplied", "Applied a label to " & ChosenItem & " on " & ChosenDate,
			        "LabelChanged", "Changed the label on " & ChosenItem & " on " & ChosenDate,
			        "CopilotInteraction", "Used Copilot on " & ChosenDate,
			        ChosenActivity & " on " & ChosenItem & " on " & ChosenDate
			    )
			RETURN
			    IF(
			        [Top Label Downgrades] = 1 && HASONEVALUE(ActivityExplorerEvents[RecordIdentity]),
			        IF(
			            ISEMPTY(Later),
			            "Nothing after",
			            Described & IF(OtherEvents > 0, " (+" & OtherEvents & " more)")
			        )
			    )
		displayFolder: Label downgrades

	measure 'Downgrade Row Fill' = IF([Downgrade Next Tag] <> "", "#FCEDED", "#FFFFFF")
		displayFolder: Label downgrades
		isHidden

	measure 'Downgrade Tag Fill' = IF([Downgrade Next Tag] <> "", "#C62828", "#FFFFFF")
		displayFolder: Label downgrades
		isHidden

	measure 'Downgrade Next Activity Color' = IF([Downgrade Next Activity] = "Nothing after", "#9AA6B2", "#1F2A33")
		displayFolder: Label downgrades
		isHidden

	/// BRO-503: display name of the second-highest-priority sensitivity label
	/// (Highly Confidential in the samples).
	measure 'Second Label Name' =
			VAR TopPriority = CALCULATE(MAX(Labels[Priority]), ALL(Labels))
			VAR NextPriority = CALCULATE(MAX(Labels[Priority]), ALL(Labels), Labels[Priority] < TopPriority)
			RETURN
			    MAXX(FILTER(ALL(Labels), Labels[Priority] = NextPriority), Labels[DisplayName])
		displayFolder: AI reads

	/// Reads by any AI tool of a resource carrying one of the two top labels.
	measure 'AI Sensitive Reads' = CALCULATE(COUNTROWS(CopilotAccessedResources), CopilotAccessedResources[Sensitive Read] = 1) + 0
		formatString: #,##0
		displayFolder: AI reads

	measure 'AI Sensitive Files' = CALCULATE(DISTINCTCOUNT(CopilotAccessedResources[ResourceId]), CopilotAccessedResources[Sensitive Read] = 1) + 0
		formatString: #,##0
		displayFolder: AI reads

	/// AccessedResources on the CopilotInteraction audit record: a resource the
	/// DLP for Copilot policy stopped carries AccessBlocked = True.
	measure 'AI Sensitive Reads Blocked' =
			CALCULATE(
			    COUNTROWS(CopilotAccessedResources),
			    CopilotAccessedResources[Sensitive Read] = 1,
			    CopilotAccessedResources[AccessBlocked] = "True"
			) + 0
		formatString: #,##0
		displayFolder: AI reads

	measure 'AI Sensitive Reads Not Blocked' = [AI Sensitive Reads] - [AI Sensitive Reads Blocked]
		formatString: #,##0
		displayFolder: AI reads

	measure 'AI Not Blocked Text' = FORMAT([AI Sensitive Reads Not Blocked], "#,##0") & " of " & FORMAT([AI Sensitive Reads], "#,##0")
		displayFolder: AI reads

	measure 'AI Reads Total' = CALCULATE(COUNTROWS(CopilotAccessedResources), CopilotAccessedResources[ResourceId] <> "") + 0
		formatString: #,##0
		displayFolder: AI reads

	measure 'AI Tools Reading Files' = CALCULATE(DISTINCTCOUNT(CopilotAccessedResources[AgentName]), CopilotAccessedResources[ResourceId] <> "") + 0
		formatString: #,##0
		displayFolder: AI reads

	measure 'AI Reads Run Header' =
			VAR FirstEvent = CALCULATE(MIN(CopilotAccessedResources[EventDate]), ALL(CopilotAccessedResources))
			VAR LastEvent = CALCULATE(MAX(CopilotAccessedResources[EventDate]), ALL(CopilotAccessedResources))
			VAR People = CALCULATE(DISTINCTCOUNT(CopilotAccessedResources[UserId]), ALL(CopilotAccessedResources))
			VAR Files = CALCULATE(DISTINCTCOUNT(CopilotAccessedResources[ResourceId]), ALL(CopilotAccessedResources), CopilotAccessedResources[ResourceId] <> "")
			RETURN
			    "Copilot interactions " & FORMAT(FirstEvent, "yyyy-mm-dd") & " to " & FORMAT(LastEvent, "yyyy-mm-dd")
			        & " " & UNICHAR(183) & " " & People & IF(People = 1, " person", " people")
			        & " " & UNICHAR(183) & " " & Files & IF(Files = 1, " file", " files")
		displayFolder: AI reads

	/// The AI tool with the most sensitive reads that were not blocked (ties: most
	/// sensitive reads, then name). Drawn red on the map and in the table.
	measure 'AI Lead Tool' =
			VAR Tools = SUMMARIZE(FILTER(ALL(CopilotAccessedResources), CopilotAccessedResources[Sensitive Read] = 1), CopilotAccessedResources[AgentName])
			VAR Scored =
			    ADDCOLUMNS(
			        Tools,
			        "Open",
			            VAR ToolName = CopilotAccessedResources[AgentName]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        ALL(CopilotAccessedResources),
			                        CopilotAccessedResources[AgentName] = ToolName
			                            && CopilotAccessedResources[Sensitive Read] = 1
			                            && CopilotAccessedResources[AccessBlocked] <> "True"
			                    )
			                ) + 0,
			        "Reads",
			            VAR ToolName = CopilotAccessedResources[AgentName]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        ALL(CopilotAccessedResources),
			                        CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[Sensitive Read] = 1
			                    )
			                )
			    )
			VAR LeadTool = TOPN(1, FILTER(Scored, [Open] > 0), [Open], DESC, [Reads], DESC, CopilotAccessedResources[AgentName], ASC)
			RETURN
			    MAXX(LeadTool, CopilotAccessedResources[AgentName])
		displayFolder: AI reads

	measure 'AI Map Subtitle' =
			VAR LeadTool = [AI Lead Tool]
			VAR LabelPair = [Top Label Name] & " or " & [Second Label Name]
			VAR LeadFiles = CALCULATE(DISTINCTCOUNT(CopilotAccessedResources[ResourceId]), ALL(CopilotAccessedResources), CopilotAccessedResources[Sensitive Read] = 1, CopilotAccessedResources[AgentName] = LeadTool)
			VAR LeadOpen =
			    CALCULATE(
			        COUNTROWS(CopilotAccessedResources),
			        ALL(CopilotAccessedResources),
			        CopilotAccessedResources[Sensitive Read] = 1,
			        CopilotAccessedResources[AgentName] = LeadTool,
			        CopilotAccessedResources[AccessBlocked] <> "True"
			    ) + 0
			VAR LeadReads = CALCULATE(COUNTROWS(CopilotAccessedResources), ALL(CopilotAccessedResources), CopilotAccessedResources[Sensitive Read] = 1, CopilotAccessedResources[AgentName] = LeadTool)
			RETURN
			    SWITCH(
			        TRUE(),
			        CALCULATE([AI Sensitive Reads], ALL(CopilotAccessedResources)) = 0, "No AI tool read a " & LabelPair & " file in this window.",
			        ISBLANK(LeadTool), "Every " & LabelPair & " read by an AI tool was blocked.",
			        LeadTool & " read " & LeadFiles & IF(LeadFiles = 1, " " & LabelPair & " file", " " & LabelPair & " files")
			            & ", and " & LeadOpen & " of its " & LeadReads & IF(LeadReads = 1, " read", " reads") & " got through, the most of any AI tool."
			    )
		displayFolder: AI reads

	/// Map of AI tool to label, sensitive reads only: up to four tools on the
	/// left, the two top labels on the right, line width by reads. Drawn as an SVG
	/// image so no custom visual is needed.
	measure 'AI Read Map' =
			VAR Font = "font-family='Segoe UI, sans-serif'"
			VAR LeadTool = [AI Lead Tool]
			VAR TopName = [Top Label Name]
			VAR NextName = [Second Label Name]
			VAR Sensitive = FILTER(ALL(CopilotAccessedResources), CopilotAccessedResources[Sensitive Read] = 1)
			VAR Tools0 = SUMMARIZE(Sensitive, CopilotAccessedResources[AgentName])
			VAR Tools1 =
			    ADDCOLUMNS(
			        Tools0,
			        "Reads", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName)),
			        "Blocked", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[AccessBlocked] = "True")) + 0,
			        "TopReads", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[Label Rank] = 1)) + 0,
			        "TopBlocked", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[Label Rank] = 1 && CopilotAccessedResources[AccessBlocked] = "True")) + 0,
			        "NextReads", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[Label Rank] = 2)) + 0,
			        "NextBlocked", VAR ToolName = CopilotAccessedResources[AgentName] RETURN COUNTROWS(FILTER(Sensitive, CopilotAccessedResources[AgentName] = ToolName && CopilotAccessedResources[Label Rank] = 2 && CopilotAccessedResources[AccessBlocked] = "True")) + 0
			    )
			VAR Ranked =
			    ADDCOLUMNS(
			        Tools1,
			        "Pos",
			            VAR ThisReads = [Reads]
			            VAR ThisName = CopilotAccessedResources[AgentName]
			            RETURN
			                COUNTROWS(FILTER(Tools1, [Reads] > ThisReads || ([Reads] = ThisReads && CopilotAccessedResources[AgentName] < ThisName))) + 1
			    )
			VAR Shown = FILTER(Ranked, [Pos] <= 4)
			VAR ToolCount = COUNTROWS(Shown)
			VAR NotShown = COUNTROWS(Ranked) - ToolCount
			VAR Slot = 300 / MAX(ToolCount, 1)
			VAR MaxLink = MAX(MAXX(Shown, [TopReads]), MAXX(Shown, [NextReads]))
			VAR TopTotal = SUMX(Ranked, [TopReads])
			VAR NextTotal = SUMX(Ranked, [NextReads])
			VAR CircleX = 420
			VAR TopY = 90
			VAR TopR = 50
			VAR NextY = 250
			VAR NextR = 52
			VAR BoxRight = 172
			VAR Placed =
			    ADDCOLUMNS(
			        Shown,
			        "CenterY", 20 + ([Pos] - 1) * Slot + Slot / 2,
			        "Safe", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CopilotAccessedResources[AgentName], "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "'", "&apos;")
			    )
			VAR LinkSvg =
			    CONCATENATEX(
			        Placed,
			        VAR CenterY = [CenterY]
			        VAR TopW = 1.5 + 7 * [TopReads] / MaxLink
			        VAR NextW = 1.5 + 7 * [NextReads] / MaxLink
			        VAR TopEndX = CircleX - TopR
			        VAR NextEndX = CircleX - NextR
			        VAR TopLabelX = BoxRight + (TopEndX - BoxRight) * 0.45
			        VAR TopLabelY = CenterY + (TopY - CenterY) * 0.3 + 3
			        VAR NextLabelX = BoxRight + (NextEndX - BoxRight) * 0.45
			        VAR NextLabelY = CenterY + (NextY - CenterY) * 0.3 + 3
			        VAR TopText = [TopReads] & IF([TopBlocked] > 0, " " & UNICHAR(183) & " " & [TopBlocked] & " blocked")
			        VAR NextText = [NextReads] & IF([NextBlocked] > 0, " " & UNICHAR(183) & " " & [NextBlocked] & " blocked")
			        VAR TopTextW = LEN(TopText) * 5 + 8
			        VAR NextTextW = LEN(NextText) * 5 + 8
			        RETURN
			            IF(
			                [TopReads] > 0,
			                "<line x1='" & BoxRight & "' y1='" & CenterY & "' x2='" & TopEndX & "' y2='" & TopY & "' stroke='%23C62828' stroke-width='" & FORMAT(TopW, "0.0") & "'/>"
			                    & "<rect x='" & FORMAT(TopLabelX - TopTextW / 2, "0.0") & "' y='" & FORMAT(TopLabelY - 10, "0.0") & "' width='" & TopTextW & "' height='13' fill='%23FFFFFF'/>"
			                    & "<text x='" & FORMAT(TopLabelX, "0.0") & "' y='" & FORMAT(TopLabelY, "0.0") & "' text-anchor='middle' " & Font & " font-size='9' fill='%23C62828'>"
			                    & TopText & "</text>"
			            )
			                & IF(
			                    [NextReads] > 0,
			                    "<line x1='" & BoxRight & "' y1='" & CenterY & "' x2='" & NextEndX & "' y2='" & NextY & "' stroke='%2316324A' stroke-width='" & FORMAT(NextW, "0.0") & "'/>"
			                        & "<rect x='" & FORMAT(NextLabelX - NextTextW / 2, "0.0") & "' y='" & FORMAT(NextLabelY - 10, "0.0") & "' width='" & NextTextW & "' height='13' fill='%23FFFFFF'/>"
			                    & "<text x='" & FORMAT(NextLabelX, "0.0") & "' y='" & FORMAT(NextLabelY, "0.0") & "' text-anchor='middle' " & Font & " font-size='9' fill='%2316324A'>"
			                        & NextText & "</text>"
			                ),
			        "",
			        [Pos], ASC
			    )
			VAR BoxSvg =
			    CONCATENATEX(
			        Placed,
			        VAR IsLead = CopilotAccessedResources[AgentName] = LeadTool
			        VAR BoxY = [CenterY] - 26
			        RETURN
			            "<rect x='12' y='" & BoxY & "' width='160' height='52' fill='" & IF(IsLead, "%23FCEDED", "%23EEF4F8") & "' stroke='" & IF(IsLead, "%23C62828", "%2316324A") & "' stroke-width='2'/>"
			                & "<text x='92' y='" & (BoxY + 22) & "' text-anchor='middle' " & Font & " font-size='11' font-weight='600' fill='" & IF(IsLead, "%23C62828", "%2316324A") & "'>" & [Safe] & "</text>"
			                & "<text x='92' y='" & (BoxY + 39) & "' text-anchor='middle' " & Font & " font-size='8.5' fill='%233D4C58'>"
			                & [Reads] & IF([Reads] = 1, " sensitive read", " sensitive reads") & " " & UNICHAR(183) & " " & [Blocked] & " blocked</text>",
			        "",
			        [Pos], ASC
			    )
			VAR CircleSvg =
			    "<circle cx='" & CircleX & "' cy='" & TopY & "' r='" & TopR & "' fill='%23C62828'/>"
			        & "<text x='" & CircleX & "' y='" & (TopY - 2) & "' text-anchor='middle' " & Font & " font-size='10' font-weight='600' fill='%23FFFFFF'>" & TopName & "</text>"
			        & "<text x='" & CircleX & "' y='" & (TopY + 15) & "' text-anchor='middle' " & Font & " font-size='9' fill='%23FFFFFF'>" & TopTotal & IF(TopTotal = 1, " read", " reads") & "</text>"
			        & "<circle cx='" & CircleX & "' cy='" & NextY & "' r='" & NextR & "' fill='%2316324A'/>"
			        & "<text x='" & CircleX & "' y='" & (NextY - 2) & "' text-anchor='middle' " & Font & " font-size='10' font-weight='600' fill='%23FFFFFF'>" & NextName & "</text>"
			        & "<text x='" & CircleX & "' y='" & (NextY + 15) & "' text-anchor='middle' " & Font & " font-size='9' fill='%23FFFFFF'>" & NextTotal & IF(NextTotal = 1, " read", " reads") & "</text>"
			VAR MoreSvg = IF(NotShown > 0, "<text x='92' y='334' text-anchor='middle' " & Font & " font-size='9' fill='%235B6B78'>+" & NotShown & IF(NotShown = 1, " more tool", " more tools") & "</text>")
			RETURN
			    IF(
			        ToolCount > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='680' viewBox='0 0 500 340'>" & LinkSvg & BoxSvg & CircleSvg & MoreSvg & "</svg>"
			    )
		displayFolder: AI reads
		dataCategory: ImageUrl

	/// One table row per sensitive read; blank on every other row so the table drops it.
	measure 'AI Read Date' =
			IF(
			    [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			    FORMAT(SELECTEDVALUE(CopilotAccessedResources[EventDate]), "yyyy-mm-dd")
			)
		displayFolder: AI reads

	measure 'AI Read Tool' =
			IF(
			    [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			    SELECTEDVALUE(CopilotAccessedResources[AgentName])
			)
		displayFolder: AI reads

	/// Who the AI tool read the file for. Honours the anonymize filter.
	measure 'AI Read Person' =
			VAR Upn = SELECTEDVALUE(CopilotAccessedResources[UserId])
			VAR RealName = MAXX(FILTER(ALL(Users), Users[UserPrincipalName] = Upn), Users[DisplayName])
			VAR Pseudonym = MAXX(FILTER(ALL(Users), Users[UserPrincipalName] = Upn), Users[Anonymous Display Name])
			RETURN
			    IF(
			        [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			        IF(
			            [Anonymize Toggle Value] = 1,
			            COALESCE(Pseudonym, "Unknown user"),
			            COALESCE(RealName, Upn)
			        )
			    )
		displayFolder: AI reads

	measure 'AI Read File' =
			IF(
			    [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			    SELECTEDVALUE(CopilotAccessedResources[ResourceName])
			)
		displayFolder: AI reads

	measure 'AI Read Label' =
			VAR LabelId = SELECTEDVALUE(CopilotAccessedResources[SensitivityLabelId])
			RETURN
			    IF(
			        [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			        MAXX(FILTER(ALL(Labels), Labels[ObjectId] = LabelId), Labels[DisplayName])
			    )
		displayFolder: AI reads

	measure 'AI Read Blocked' =
			IF(
			    [AI Sensitive Reads] = 1 && HASONEVALUE(CopilotAccessedResources[Read Key]),
			    IF(SELECTEDVALUE(CopilotAccessedResources[AccessBlocked]) = "True", "BLOCKED", "")
			)
		displayFolder: AI reads

	measure 'AI Read Row Fill' = IF(SELECTEDVALUE(CopilotAccessedResources[Label Rank]) = 1, "#FDF3F3", "#FFFFFF")
		displayFolder: AI reads
		isHidden

	measure 'AI Read Label Fill' = IF(SELECTEDVALUE(CopilotAccessedResources[Label Rank]) = 1, "#FBE3E3", "#EEF1F4")
		displayFolder: AI reads
		isHidden

	measure 'AI Read Label Color' = IF(SELECTEDVALUE(CopilotAccessedResources[Label Rank]) = 1, "#C62828", "#16324A")
		displayFolder: AI reads
		isHidden

	measure 'AI Read Tool Color' = IF(SELECTEDVALUE(CopilotAccessedResources[AgentName]) = [AI Lead Tool], "#C62828", "#1F2A33")
		displayFolder: AI reads
		isHidden

	/// The enabled DLP rule, in a Copilot-scoped DLP policy, that blocks access
	/// and names the top label (in its name or its label list).
	measure 'AI One Fix Rule' =
			VAR TopName = [Top Label Name]
			VAR CopilotPolicies = CALCULATETABLE(VALUES(Policies[ObjectId]), ALL(Policies), Policies[ObjectType] = "DlpPolicy", Policies[AppliesToCopilot] = "True")
			VAR Rules =
			    FILTER(
			        ALL(Policies),
			        Policies[ObjectType] = "DlpRule"
			            && Policies[Enabled] = "True"
			            && Policies[BlockAccess] = "True"
			            && Policies[ParentId] IN CopilotPolicies
			            && (CONTAINSSTRING(Policies[Name], TopName) || CONTAINSSTRING(Policies[LabelNames], TopName))
			    )
			RETURN
			    MINX(Rules, Policies[Name])
		displayFolder: AI reads

	measure 'AI One Fix Title' =
			VAR RuleName = [AI One Fix Rule]
			RETURN
			    IF(ISBLANK(RuleName), "Block Copilot from " & [Top Label Name] & " files", "Fix " & UNICHAR(8220) & RuleName & UNICHAR(8221))
		displayFolder: AI reads

	measure 'AI One Fix Detail' =
			VAR TopName = [Top Label Name]
			VAR TopReads = CALCULATE(COUNTROWS(CopilotAccessedResources), ALL(CopilotAccessedResources), CopilotAccessedResources[Label Rank] = 1, CopilotAccessedResources[ResourceId] <> "") + 0
			VAR TopBlocked = CALCULATE(COUNTROWS(CopilotAccessedResources), ALL(CopilotAccessedResources), CopilotAccessedResources[Label Rank] = 1, CopilotAccessedResources[ResourceId] <> "", CopilotAccessedResources[AccessBlocked] = "True") + 0
			VAR HasRule = NOT ISBLANK([AI One Fix Rule])
			RETURN
			    SWITCH(
			        TRUE(),
			        TopReads = 0, "No AI tool has read a " & TopName & " file yet.",
			        HasRule && TopBlocked < TopReads, "It shows as enabled, yet it stopped only " & TopBlocked & " of " & TopReads & " " & TopName & " reads.",
			        HasRule, "It stopped all " & TopReads & " " & TopName & " reads. Keep it on.",
			        "No enabled DLP rule stops Copilot on " & TopName & "; " & (TopReads - TopBlocked) & " of " & TopReads & " reads went through."
			    )
		displayFolder: AI reads

	/// "sample data, example.com" appears only when users.csv holds @example.com accounts.
	measure 'AI Reads Sources' =
			VAR SampleUsers = CALCULATE(COUNTROWS(Users), ALL(Users), RIGHT(Users[UserPrincipalName], 12) = "@example.com")
			RETURN
			    "Sources: copilot-accessed-resources.csv " & UNICHAR(183) & " policies.csv"
			        & IF(SampleUsers > 0, " " & UNICHAR(183) & " sample data, example.com")
		displayFolder: AI reads

	partition _Measures = calculated
		mode: import
		source =
				ROW("Measures Key", 1)

