    partition CopilotFeatureAvailability = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\copilot-feature-availability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                #"Changed Type" = Table.TransformColumnTypes(Cleaned, {{"RunDate", type date}, {"PageReadDate", type date}})
            in
                #"Changed Type"

    annotation PBI_ResultType = Table
