{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-archive-state",
  "position": {
    "x": 0,
    "y": 220,
    "z": 0,
    "width": 630,
    "height": 250,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "TeamArchiveStatus"
                    }
                  },
                  "Property": "ArchiveLabel"
                }
              },
              "queryRef": "TeamArchiveStatus.ArchiveLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "TeamArchiveStatus"
                    }
                  },
                  "Property": "Teams Checked For Archive"
                }
              },
              "queryRef": "TeamArchiveStatus.Teams Checked For Archive"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Teams by archive state"
          }
        }
      ]
    }
  }
}
