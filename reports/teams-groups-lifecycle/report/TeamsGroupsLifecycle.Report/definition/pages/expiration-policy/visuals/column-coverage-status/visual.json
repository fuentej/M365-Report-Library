                }
              },
              "queryRef": "GroupLifecycleCoverage.CoverageStatus",
              "nativeQueryRef": "CoverageStatus",
              "displayName": "Expiration policy coverage"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GroupLifecycleCoverage"
                    }
                  },
                  "Property": "Groups (Coverage Snapshot)"
                }
              },
              "queryRef": "GroupLifecycleCoverage.Groups (Coverage Snapshot)",
              "nativeQueryRef": "Groups (Coverage Snapshot)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Groups by coverage (members need Entra ID P1 or P2)'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}
