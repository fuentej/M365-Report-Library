{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-events-by-month",
  "position": {
    "x": 650,
    "y": 220,
    "z": 0,
    "width": 630,
    "height": 250,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DateDim"
                    }
                  },
                  "Property": "YearMonth"
                }
              },
              "queryRef": "DateDim.YearMonth"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GroupCreationEvents"
                    }
                  },
                  "Property": "Creation Events"
                }
              },
              "queryRef": "GroupCreationEvents.Creation Events"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Creation events per month (audit retention 180 days)"
          }
        }
      ]
    }
  }
}
