table GroupsCurrent
    lineageTag: 254d0621-fe7d-5aaa-860d-f0e7c927b78a

    column RunDate
        dataType: dateTime
        formatString: Short Date
        lineageTag: be048250-e353-5040-8f96-f0e13ddb1aa0
        summarizeBy: none
        sourceColumn: RunDate

    column Id
        dataType: string
        lineageTag: 04beee01-eabe-5d30-88ec-5883b1f7f83e
        summarizeBy: none
        sourceColumn: Id

