    column PseudonymNumber = 
            VAR IdText = UsersCurrent[Id]
            VAR CharCount = LEN(IdText)
            VAR HashSeed = SUMX(GENERATESERIES(1, CharCount), UNICODE(MID(IdText, [Value], 1)) * MOD([Value] * [Value] * 37 + [Value] * 101, 9973))
            RETURN MOD(HashSeed, 90000) + 10000
        dataType: int64
        formatString: 00000
        lineageTag: f314d930-5d72-5429-93b9-ea801609fc45
        summarizeBy: none
        isDataTypeInferred: false

    column Pseudonym = "User " & FORMAT(UsersCurrent[PseudonymNumber], "00000")
        dataType: string
        lineageTag: 1c2e111e-eddc-58e3-9d8c-5cceb5221bb6
        summarizeBy: none
        isDataTypeInferred: false

    partition UsersCurrent = calculated
        mode: import
        source =
            FILTER(Users, Users[RunDate] = MAX(Users[RunDate]))

    annotation PBI_ResultType = Table
