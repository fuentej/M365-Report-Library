table TeamActivity
    lineageTag: 943f1b2d-dba6-5475-bfe6-dc3096e14e21

    column RunDate
        dataType: dateTime
        formatString: Short Date
        lineageTag: 065b783c-dc14-501a-a7ad-cbbbe8b6d977
        summarizeBy: none
