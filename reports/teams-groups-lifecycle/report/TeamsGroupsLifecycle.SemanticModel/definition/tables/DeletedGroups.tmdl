            RETURN CALCULATE(MAX(DeletedGroups[DaysToPurge]), DeletedGroups[RunDate] = SnapshotDate, DeletedGroups[RestoreSlot] = 3)
        formatString: #,0
        lineageTag: d3e1313a-9744-41ff-80af-fcc5e8aad23c

