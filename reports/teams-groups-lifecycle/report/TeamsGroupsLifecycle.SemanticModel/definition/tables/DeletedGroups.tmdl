            RETURN IF(ISBLANK(Days), "#8A9099", IF(Days < 10, "#C62828", IF(Days < 20, "#D98A00", "#138A8A")))
        lineageTag: cc15ec25-5614-4ef3-9c5b-2b8db9d93d08

