    /// Headline sentence. Files are rounded to the nearest thousand.
    measure 'Groups Without Working Owner Headline' =
            VAR N = [Groups Without Working Owner]
            VAR P = COALESCE([People In Groups Without Working Owner], 0)
            VAR X = COALESCE([Outside Members In Groups Without Working Owner], 0)
            VAR F = COALESCE([Files In Groups Without Working Owner], 0)
            VAR Rounded = ROUND(F, -3)
            VAR FilesText = IF(F < 1000 || Rounded = F, FORMAT(F, "#,0"), IF(Rounded > F, "nearly ", "over ") & FORMAT(Rounded, "#,0"))
            RETURN IF(COALESCE(N, 0) = 0, "Every group has a working owner.", FORMAT(N, "#,0") & IF(N = 1, " group has no working owner. It holds ", " groups have no working owner. Together they hold ") & FORMAT(P, "#,0") & " people, " & FORMAT(X, "#,0") & " of them from outside, and " & FilesText & " files.")
        lineageTag: 7177b20c-c6d8-41cf-a7d7-5e693f72782a

