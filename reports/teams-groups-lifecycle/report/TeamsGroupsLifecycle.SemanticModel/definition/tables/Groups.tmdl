    column IsTeam
        dataType: boolean
        lineageTag: b6bd9786-810c-59f1-82ac-658bd8b857b0
        summarizeBy: none
        sourceColumn: IsTeam

    column SnapshotKey = FORMAT(Groups[RunDate], "yyyy-MM-dd") & "|" & Groups[Id]
        dataType: string
        lineageTag: 9d32df54-a96d-5ed3-ba01-8411d5cd3f58
        summarizeBy: none
        isDataTypeInferred: false

    /// Days from creation to this snapshot's UTC RunDate.
    column DaysSinceCreated = DATEDIFF(Groups[CreatedDateTime], Groups[RunDate], DAY)
        dataType: int64
        formatString: #,0
        lineageTag: 9030b5a9-c0e3-5117-8370-769799b73ace
        summarizeBy: none
        isDataTypeInferred: false

    column CreatedYearMonth = FORMAT(Groups[CreatedDateTime], "yyyy-MM")
        dataType: string
        lineageTag: 3859aa87-7545-5af5-83ca-34d5d2b32e60
        summarizeBy: none
        isDataTypeInferred: false

    /// Blank when no expiration policy applies to the group (ExpirationDateTime is empty). Never coerced to 0.
    column DaysToExpiry = IF(ISBLANK(Groups[ExpirationDateTime]), BLANK(), DATEDIFF(Groups[RunDate], Groups[ExpirationDateTime], DAY))
        dataType: int64
        formatString: #,0
        lineageTag: 80b417c9-35c1-54dd-b041-83ce65789b20
        summarizeBy: none
        isDataTypeInferred: false

    column ExpiryBucket = 
            VAR d = Groups[DaysToExpiry]
            RETURN IF(ISBLANK(d), "No expiration date", IF(d < 0, "Past expiration date", IF(d <= 30, "0-30 days", IF(d <= 60, "31-60 days", IF(d <= 90, "61-90 days", "More than 90 days")))))
        dataType: string
        lineageTag: c24305fc-3c8d-5b84-8619-ce4b6db9636e
        summarizeBy: none
        isDataTypeInferred: false

    /// Owners Graph returned for this group on this snapshot. Meaningful only when OwnerStatus is not "Owner unknown".
    column OwnerListedCount = COUNTROWS(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerListStatus] = "Listed"))
        dataType: int64
        formatString: #,0
        lineageTag: d4f62fbb-8720-585a-8881-c68386d0bbc5
        summarizeBy: none
        isDataTypeInferred: false

    /// Graph cannot list owners for some groups (Exchange-created, distribution, on-premises synced): those are "Owner unknown", not "No owner". A group with no group-owners.csv row on the snapshot is also unknown.
    column OwnerStatus = 
            VAR OwnerRows = RELATEDTABLE(GroupOwners)
            VAR RowCount = COUNTROWS(OwnerRows)
            VAR UnknownRows = COUNTROWS(FILTER(OwnerRows, GroupOwners[OwnerListStatus] = "Unknown"))
            VAR NoneRows = COUNTROWS(FILTER(OwnerRows, GroupOwners[OwnerListStatus] = "None"))
            VAR Listed = Groups[OwnerListedCount]
            RETURN IF(RowCount = 0 || UnknownRows > 0, "Owner unknown", IF(Listed = 0 && NoneRows > 0, "No owner", IF(Listed = 1, "One owner", "Two or more owners")))
        dataType: string
        lineageTag: 4ddcbfe7-2062-554a-bc7f-941a2ad796d4
        summarizeBy: none
        isDataTypeInferred: false

    column DisabledOwnerCount = COUNTROWS(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Disabled"))
        dataType: int64
        formatString: #,0
        lineageTag: 6d173d6c-97e4-5833-8a04-c9552bcee1a7
        summarizeBy: none
        isDataTypeInferred: false

    /// Listed owners whose account is enabled in the latest users.csv: a working owner.
    column WorkingOwnerCount = COUNTROWS(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Enabled"))
        dataType: int64
        formatString: #,0
        lineageTag: 7cb09a44-07e0-4269-a92b-ed4cd8c3e81e
        summarizeBy: none
        isDataTypeInferred: false

    /// Listed owners missing from users.csv. Whether they still work is unknown.
    column UnknownStateOwnerCount = COUNTROWS(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Unknown"))
        dataType: int64
        formatString: #,0
        lineageTag: ad389ac6-af4b-43d2-b74f-e9b0d8746812
        summarizeBy: none
        isDataTypeInferred: false

    /// Graph listed the owners (or said there are none) and none of them has an enabled account. An unknown owner list, or an owner missing from users.csv, is not counted as no working owner.
    column HasNoWorkingOwner = Groups[OwnerStatus] <> "Owner unknown" && Groups[WorkingOwnerCount] = 0 && Groups[UnknownStateOwnerCount] = 0
        dataType: boolean
        lineageTag: b90568e1-08c4-4e8a-b07f-f5d6c9b1d21b
        summarizeBy: none
        isDataTypeInferred: false

    /// Listed owners whose account is disabled. Read through Departed Owner (Display), which honours the Anonymize toggle.
    column DepartedOwnerNames = CONCATENATEX(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Disabled"), GroupOwners[OwnerDisplayName], ", ", GroupOwners[OwnerDisplayName])
        dataType: string
        lineageTag: cea70e0c-a8b3-4d25-b837-058cdd7f4980
        summarizeBy: none
        isDataTypeInferred: false

    column DepartedOwnerPseudonyms = CONCATENATEX(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Disabled"), GroupOwners[Pseudonym], ", ", GroupOwners[Pseudonym])
        dataType: string
        lineageTag: 24f240af-c118-41c7-91d9-d537892c703b
        summarizeBy: none
        isDataTypeInferred: false

    /// The departed owner's manager from the latest users.csv. Blank when no listed owner is disabled or users.csv has no manager.
    column DepartedOwnerManager = LOOKUPVALUE(UsersCurrent[ManagerUserPrincipalName], UsersCurrent[Id], MINX(FILTER(RELATEDTABLE(GroupOwners), GroupOwners[OwnerAccountState] = "Disabled"), GroupOwners[OwnerId]))
        dataType: string
        lineageTag: 637aac58-ef17-43f0-8feb-a6426d80d79c
        summarizeBy: none
        isDataTypeInferred: false

    /// Who created the group, from the creation audit record whose TargetGroupId (the TeamGuid) is this group. AddGroup records carry no TargetGroupId, so only team creations name a creator. Audit (Standard) keeps 180 days.
    column Creator =
            VAR GroupId = Groups[Id]
            VAR Events = FILTER(GroupCreationEvents, GroupCreationEvents[TargetGroupId] = GroupId)
            RETURN MAXX(TOPN(1, Events, GroupCreationEvents[CreationTime], ASC), GroupCreationEvents[UserId])
        dataType: string
        lineageTag: 1d0c6b8e-eccc-4fd1-80d4-bb97b3ac2f9d
        summarizeBy: none
        isDataTypeInferred: false

    /// The departed owner's manager, else the person who created the group. Blank when neither is on record.
    column SuggestedOwner =
            VAR Manager = Groups[DepartedOwnerManager]
            VAR CreatedBy = Groups[Creator]
            RETURN IF(NOT ISBLANK(Manager), LEFT(Manager, SEARCH("@", Manager & "@") - 1) & " (manager)", IF(NOT ISBLANK(CreatedBy), LEFT(CreatedBy, SEARCH("@", CreatedBy & "@") - 1) & " (creator)", BLANK()))
        dataType: string
        lineageTag: eb06aea1-0e73-4e00-b8dd-2e2bf02e2d7f
        summarizeBy: none
        isDataTypeInferred: false

    column SuggestedOwnerPseudonym =
            VAR Manager = Groups[DepartedOwnerManager]
            VAR GroupId = Groups[Id]
            VAR Events = FILTER(GroupCreationEvents, GroupCreationEvents[TargetGroupId] = GroupId)
            VAR CreatorPseudo = MAXX(TOPN(1, Events, GroupCreationEvents[CreationTime], ASC), GroupCreationEvents[CreatorPseudonym])
            VAR ManagerPseudo = LOOKUPVALUE(UsersCurrent[Pseudonym], UsersCurrent[UserPrincipalName], Manager)
            RETURN IF(NOT ISBLANK(Manager), COALESCE(ManagerPseudo, "Unmatched user") & " (manager)", IF(NOT ISBLANK(CreatorPseudo), CreatorPseudo & " (creator)", BLANK()))
        dataType: string
        lineageTag: 1436c4c6-834c-4a50-b0ed-f3d6e28bc96a
        summarizeBy: none
        isDataTypeInferred: false

    /// From group-activity.csv on the same snapshot. Blank when the usage report has no row for the group.
    column MemberCount = LOOKUPVALUE(GroupActivity[MemberCount], GroupActivity[SnapshotKey], Groups[SnapshotKey])
        dataType: int64
        formatString: #,0
        lineageTag: 39b9af19-f9a6-4188-98c1-a3007cc53cd6
        summarizeBy: none
        isDataTypeInferred: false

    column OutsideMemberCount = LOOKUPVALUE(GroupActivity[ExternalMemberCount], GroupActivity[SnapshotKey], Groups[SnapshotKey])
        dataType: int64
        formatString: #,0
        lineageTag: 9c168439-ee74-4c29-bbcd-c9d4c53f6b59
        summarizeBy: none
        isDataTypeInferred: false

    column FileCount = LOOKUPVALUE(GroupActivity[SharePointTotalFileCount], GroupActivity[SnapshotKey], Groups[SnapshotKey])
        dataType: int64
        formatString: #,0
        lineageTag: d3f9014a-77c9-47e1-b838-d6a7ffa7b4c2
        summarizeBy: none
        isDataTypeInferred: false

    column LastActivityDate = LOOKUPVALUE(GroupActivity[LastActivityDate], GroupActivity[SnapshotKey], Groups[SnapshotKey])
        dataType: dateTime
        formatString: yyyy-MM-dd
        lineageTag: 5eaf9f2e-f978-46b3-a991-2f730fc6d03c
        summarizeBy: none
        isDataTypeInferred: false

    /// Days from the last activity date to the RunDate. Blank, not 0, when the date is unknown.
    column DaysQuiet = LOOKUPVALUE(GroupActivity[DaysSinceLastActivity], GroupActivity[SnapshotKey], Groups[SnapshotKey])
        dataType: int64
        formatString: #,0
        lineageTag: 91f97db3-2d3c-4922-bd01-0fafffff1786
        summarizeBy: none
        isDataTypeInferred: false

    column QuietBandOrder =
            VAR d = Groups[DaysQuiet]
            RETURN IF(ISBLANK(d), 6, IF(d <= 30, 1, IF(d <= 90, 2, IF(d <= 180, 3, IF(d <= 365, 4, 5)))))
        dataType: int64
        lineageTag: 4eb53a74-5ad9-4a2b-8d13-8f1c498dc1bb
        summarizeBy: none
        isDataTypeInferred: false

    /// Days since last activity. Dead means more than 90 days.
    column QuietBand =
            VAR d = Groups[DaysQuiet]
            RETURN IF(ISBLANK(d), "No activity date", IF(d <= 30, "0-30 days", IF(d <= 90, "31-90", IF(d <= 180, "91-180", IF(d <= 365, "181-365", "365+")))))
        dataType: string
        lineageTag: 057793b3-62bd-45d0-a9b6-3b135b677788
        summarizeBy: none
        isDataTypeInferred: false
        sortByColumn: QuietBandOrder

    /// Covered, NotCovered or Unknown from group-lifecycle-coverage.csv on the same snapshot. Blank when there is no row.
    column CoverageStatus = MAXX(RELATEDTABLE(GroupLifecycleCoverage), GroupLifecycleCoverage[CoverageStatus])
        dataType: string
        lineageTag: 4f29a425-0b66-4ff1-9e72-77f6a3a447c3
        summarizeBy: none
        isDataTypeInferred: false

    column ExpiryCoverageLabel = SWITCH(Groups[CoverageStatus], "Covered", "covered by expiration", "NotCovered", "never expires", "coverage unknown")
        dataType: string
        lineageTag: 98ce2768-c6da-463d-b3fd-fedf8cd6de7d
        summarizeBy: none
        isDataTypeInferred: false

    column IsArchivedTeam = COUNTROWS(FILTER(RELATEDTABLE(TeamArchiveStatus), TeamArchiveStatus[IsArchived] = TRUE())) > 0
        dataType: boolean
        lineageTag: 0e9beda1-9de3-4ee7-81fc-ca0435a77902
        summarizeBy: none
        isDataTypeInferred: false

    /// Latest snapshot RunDate inside the current date slicer, ignoring the visual's own group axis.
    measure 'Selected Snapshot Date' = CALCULATE(MAX(Groups[RunDate]), ALLSELECTED(Groups), ALLSELECTED(GroupsCurrent))
        formatString: Short Date
        lineageTag: 082eb9d4-bfa0-5137-8628-acd2b3e4306e

    /// Every snapshot row. The Overview trend plots this by RunDate.
    measure 'Group Count (All Snapshots)' = COUNTROWS(Groups)
        formatString: #,0
        lineageTag: b443ac94-6fdd-5cd9-b79e-18ac0bfc2c00

    measure 'Team Count (All Snapshots)' = CALCULATE(COUNTROWS(Groups), Groups[IsTeam] = TRUE())
        formatString: #,0
        lineageTag: c0b95a6a-9b01-58c2-bce2-43ea4477d665

    /// Microsoft 365 groups on the selected snapshot, Teams included.
    measure 'Group Count' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
        formatString: #,0
        lineageTag: 4e921db8-0f12-520f-9666-a22e789b6924

    /// IsTeam is ResourceProvisioningOptions containing Team; some old unused teams do not carry it.
    measure 'Team Count' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[IsTeam] = TRUE())
        formatString: #,0
        lineageTag: 428f47d3-b21c-58bc-bbe0-19f3a93bf68b

    measure 'Groups Without Owner' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[OwnerStatus] = "No owner")
        formatString: #,0
        lineageTag: 4f5a1796-eeb2-57f0-8550-d67d4d43b8be

    measure 'Single-Owner Groups' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[OwnerStatus] = "One owner")
        formatString: #,0
        lineageTag: f32134c0-ccaa-52bf-80fe-27af89e79e1f

    /// Graph could not return owners, or no owner row exists. Reported as unknown, never as no owner.
    measure 'Owner Unknown Groups' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[OwnerStatus] = "Owner unknown")
        formatString: #,0
        lineageTag: 614986ce-4c30-587e-a017-5e4244a2cead

    measure 'Groups With Disabled Owners' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[DisabledOwnerCount] > 0)
        formatString: #,0
        lineageTag: 492d91a5-758f-5e1c-834b-a80bbd68448b

    measure 'Expiring Within 30 Days' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, NOT ISBLANK(Groups[DaysToExpiry]), Groups[DaysToExpiry] >= 0, Groups[DaysToExpiry] <= 30)
        formatString: #,0
        lineageTag: 46c1c96f-8f9a-5a64-b410-176afbb1011b

    measure 'Expiring Within 60 Days' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, NOT ISBLANK(Groups[DaysToExpiry]), Groups[DaysToExpiry] >= 0, Groups[DaysToExpiry] <= 60)
        formatString: #,0
        lineageTag: ccb47445-19a0-5134-a34f-fa3156680b47

    measure 'Expiring Within 90 Days' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, NOT ISBLANK(Groups[DaysToExpiry]), Groups[DaysToExpiry] >= 0, Groups[DaysToExpiry] <= 90)
        formatString: #,0
        lineageTag: 31788b3c-0318-5cec-8328-892e6f5e8dee

    measure 'Past Expiration Date' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, NOT ISBLANK(Groups[DaysToExpiry]), Groups[DaysToExpiry] < 0)
        formatString: #,0
        lineageTag: 7ee7183a-bde3-5ff5-a072-478c554a737b

    /// ExpirationDateTime is empty when no expiration policy applies to the group.
    measure 'Groups Without Expiration Date' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, ISBLANK(Groups[ExpirationDateTime]))
        formatString: #,0
        lineageTag: 0f3c2cf0-7e84-54d2-bf07-7d60ef0ad185

    /// Plotted by Groups[CreatedYearMonth]. Needs no audit record.
    measure 'Groups Created' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
        formatString: #,0
        lineageTag: df7cae80-4699-544a-b119-94bb542cfb4d

    measure 'Teams Created' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[IsTeam] = TRUE())
        formatString: #,0
        lineageTag: 1d3afc70-67e0-55d2-b984-5455ed201428

    measure 'Owner Status (Display)' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR OnSnapshot = CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
            VAR FoundValue = CALCULATE(MAX(Groups[OwnerStatus]), Groups[RunDate] = SnapshotDate)
            RETURN IF(OnSnapshot = 0 || ISBLANK(FoundValue), "Owner unknown", FoundValue)
        lineageTag: 4fc5568b-a890-5ead-a113-d89a9eeb3fa2

    measure 'Owner Count (Display)' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR OnSnapshot = CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
            VAR FoundStatus = CALCULATE(MAX(Groups[OwnerStatus]), Groups[RunDate] = SnapshotDate)
            VAR Listed = CALCULATE(MAX(Groups[OwnerListedCount]), Groups[RunDate] = SnapshotDate)
            RETURN IF(OnSnapshot = 0 || FoundStatus = "Owner unknown", "Unknown", FORMAT(Listed, "#,0"))
        lineageTag: 7e02658d-dc70-55d1-9824-fe55b43bdc20

    measure 'Disabled Owners (Display)' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR OnSnapshot = CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
            VAR FoundStatus = CALCULATE(MAX(Groups[OwnerStatus]), Groups[RunDate] = SnapshotDate)
            VAR DisabledCount = CALCULATE(MAX(Groups[DisabledOwnerCount]), Groups[RunDate] = SnapshotDate)
            RETURN IF(OnSnapshot = 0 || FoundStatus = "Owner unknown", "Unknown", FORMAT(DisabledCount, "#,0"))
        lineageTag: 2aadda22-41d3-56c2-aa5b-c6deb763ddf9

    measure 'Expiration Date (Display)' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR OnSnapshot = CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
            VAR Expires = CALCULATE(MAX(Groups[ExpirationDateTime]), Groups[RunDate] = SnapshotDate)
            RETURN IF(OnSnapshot = 0, "Unknown", IF(ISBLANK(Expires), "No expiration date", FORMAT(Expires, "yyyy-MM-dd")))
        lineageTag: f3320e1b-a948-5b7f-9685-7ef32988b164

    measure 'Days To Expiry (Display)' = 
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR OnSnapshot = CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate)
            VAR Days = CALCULATE(MAX(Groups[DaysToExpiry]), Groups[RunDate] = SnapshotDate)
            RETURN IF(OnSnapshot = 0, "Unknown", IF(ISBLANK(Days), "No expiration date", FORMAT(Days, "#,0") & " days"))
        lineageTag: 60df43d9-6552-5129-a797-5fd95944f5dd

    /// Header line on the Groups nobody owns page.
    measure 'Lifecycle Run Header' =
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN "Run " & FORMAT(SnapshotDate, "yyyy-MM-dd") & " · " & FORMAT([Group Count], "#,0") & " groups, " & FORMAT([Team Count], "#,0") & " teams"
        lineageTag: f65c2fbf-75e2-4029-b330-9cdbab03f864

    /// Header line on The graveyard page.
    measure 'Expiration Policy Header' =
            VAR SnapshotDate = [Selected Snapshot Date]
            VAR PolicyScope = [Policy Scope]
            VAR Lifetime = [Expiration Policy Lifetime]
            VAR ScopeText = SWITCH(PolicyScope, "Selected", "selected groups only", "All", "all groups", "None", "turned off", "scope unknown")
            VAR PolicyText = IF(PolicyScope = "No policy row", "none recorded", Lifetime & ", " & ScopeText)
            RETURN "Run " & FORMAT(SnapshotDate, "yyyy-MM-dd") & " · expiration policy: " & PolicyText
        lineageTag: f379b2e1-4dc7-4693-91fa-c9a57b6fd4d9

    /// Shown in the footer only when the users carry the example.com sample domain.
    measure 'Sample Data Note' = IF(COUNTROWS(FILTER(UsersCurrent, RIGHT(UsersCurrent[UserPrincipalName], 12) = "@example.com")) > 0, " · sample data, example.com", "")
        lineageTag: 2ff8bea9-dacd-4b54-8d6e-12e41d3b5992

    measure 'Owners Page Sources' = "Sources: groups.csv · group-owners.csv · users.csv · group-activity.csv · group-creation-events.csv · deleted-groups.csv" & [Sample Data Note]
        lineageTag: a2bb39bc-b462-4f76-bc5c-93c297ce913a

    measure 'Graveyard Page Sources' = "Sources: groups.csv · group-activity.csv · group-lifecycle-policies.csv · group-lifecycle-coverage.csv" & [Sample Data Note]
        lineageTag: bb5639e1-4cd8-419a-9056-fef285ef1091

    /// Groups on the snapshot where no listed owner has an enabled account.
    measure 'Groups Without Working Owner' =
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(COUNTROWS(Groups), Groups[RunDate] = SnapshotDate, Groups[HasNoWorkingOwner] = TRUE())
        formatString: #,0
        lineageTag: 7d71e6e7-8eef-4727-a0fc-844c6b1fd59c

    measure 'People In Groups Without Working Owner' =
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(SUM(Groups[MemberCount]), Groups[RunDate] = SnapshotDate, Groups[HasNoWorkingOwner] = TRUE())
        formatString: #,0
        lineageTag: 4340d62c-e41c-4b62-811f-da1acde78490

    measure 'Outside Members In Groups Without Working Owner' =
            VAR SnapshotDate = [Selected Snapshot Date]
            RETURN CALCULATE(SUM(Groups[OutsideMemberCount]), Groups[RunDate] = SnapshotDate, Groups[HasNoWorkingOwner] = TRUE())
        formatString: #,0
        lineageTag: 0c4f114d-b6d0-4852-a55c-1a9280aef006

    measure 'Files In Groups Without Working Owner' =
