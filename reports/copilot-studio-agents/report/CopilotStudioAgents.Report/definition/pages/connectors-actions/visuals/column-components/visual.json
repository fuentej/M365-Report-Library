{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-components",
  "position": {
    "x": 650,
    "y": 260,
    "z": 0,
    "width": 630,
    "height": 200,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "AgentComponents"
                    }
                  },
                  "Property": "CategoryLabel"
                }
              },
              "queryRef": "AgentComponents.CategoryLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "AgentComponents"
                    }
                  },
                  "Property": "Components"
                }
              },
              "queryRef": "AgentComponents.Components"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Components by category (Unknown = no value returned)"
          }
        }
      ]
    }
  }
}
