{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-by-publish-state",
  "position": {
    "x": 430,
    "y": 260,
    "z": 0,
    "width": 420,
    "height": 200,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "PublishState"
                }
              },
              "queryRef": "Agents.PublishState"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Agent Count"
                }
              },
              "queryRef": "Agents.Agent Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Published vs draft"
          }
        }
      ]
    }
  }
}
