{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "line-trend",
  "position": {
    "x": 0,
    "y": 470,
    "z": 0,
    "width": 1280,
    "height": 250,
    "tabOrder": 12
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DateDim"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "DateDim.Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Agent Count (All Snapshots)"
                }
              },
              "queryRef": "Agents.Agent Count (All Snapshots)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Published Agents (All Snapshots)"
                }
              },
              "queryRef": "Agents.Published Agents (All Snapshots)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Agents by snapshot date"
          }
        }
      ]
    }
  }
}
