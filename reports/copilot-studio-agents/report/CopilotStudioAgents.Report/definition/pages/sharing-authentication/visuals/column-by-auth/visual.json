                  "Property": "AuthenticationLabel"
                }
              },
              "queryRef": "Agents.AuthenticationLabel",
              "nativeQueryRef": "AuthenticationLabel",
              "displayName": "Authentication"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Agent Count"
                }
              },
              "queryRef": "Agents.Agent Count",
              "nativeQueryRef": "Agent Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Agents by authentication mode (Unknown = no value returned)'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}
