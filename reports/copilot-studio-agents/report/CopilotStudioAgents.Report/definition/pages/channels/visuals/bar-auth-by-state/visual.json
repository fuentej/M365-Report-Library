{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar-auth-by-state",
  "position": {
    "x": 650,
    "y": 260,
    "z": 0,
    "width": 630,
    "height": 200,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "AuthenticationLabel"
                }
              },
              "queryRef": "Agents.AuthenticationLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Published Agents"
                }
              },
              "queryRef": "Agents.Published Agents"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Agents"
                    }
                  },
                  "Property": "Draft Agents"
                }
              },
              "queryRef": "Agents.Draft Agents"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Authentication of published and draft agents"
          }
        }
      ]
    }
  }
}
