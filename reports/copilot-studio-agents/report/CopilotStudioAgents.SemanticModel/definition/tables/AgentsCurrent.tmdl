    /// The Where they live panel as an SVG image: up to six environments, personal and trial first, each with its type and one dot per agent (up to eight). Names follow the Anonymize toggle.
    measure 'Where They Live Image' =
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR Font = "font-family='Segoe UI, sans-serif'"
            VAR EnvList =
                ADDCOLUMNS(
                    ALL(EnvironmentsCurrent[EnvironmentId], EnvironmentsCurrent[DisplayName], EnvironmentsCurrent[Pseudonym], EnvironmentsCurrent[EnvironmentType]),
                    "Shown", IF(Mode = "Anonymize", EnvironmentsCurrent[Pseudonym], EnvironmentsCurrent[DisplayName]),
                    "AgentsHere",
                        VAR EnvKey = EnvironmentsCurrent[EnvironmentId]
                        RETURN COUNTROWS(FILTER(ALL(AgentsCurrent[AgentId], AgentsCurrent[EnvironmentId]), AgentsCurrent[EnvironmentId] = EnvKey)) + 0,
                    "TypeRank", SWITCH(EnvironmentsCurrent[EnvironmentType], "Developer", 1, "Trial", 2, "Sandbox", 3, "Default", 4, "Production", 5, 6)
                )
            VAR Keyed = ADDCOLUMNS(EnvList, "SortKey", [TypeRank] * 10000 + 999 - MIN([AgentsHere], 999))
            VAR Ranked =
                ADDCOLUMNS(
                    Keyed,
                    "RowNo",
                        VAR ThisKey = [SortKey]
                        VAR ThisName = [Shown]
                        VAR ThisId = EnvironmentsCurrent[EnvironmentId]
                        RETURN
                            COUNTROWS(
                                FILTER(
                                    Keyed,
                                    [SortKey] < ThisKey || ([SortKey] = ThisKey && ([Shown] < ThisName || ([Shown] = ThisName && EnvironmentsCurrent[EnvironmentId] < ThisId)))
                                )
                            ) + 1
                )
            VAR EnvRowsSvg =
                CONCATENATEX(
                    FILTER(Ranked, [RowNo] <= 6),
                    VAR RowTop = ([RowNo] - 1) * 21.8
                    VAR EnvType = EnvironmentsCurrent[EnvironmentType]
                    VAR NameInk = SWITCH(EnvType, "Developer", "%23C62828", "Trial", "%23D98A00", "%231F2A33")
                    VAR DotInk = SWITCH(EnvType, "Developer", "%23C62828", "Trial", "%23D98A00", "%2316324A")
                    VAR WeightAttr = IF(EnvType IN {"Developer", "Trial"}, " font-weight='600'", "")
                    VAR NameRaw = IF(LEN([Shown]) > 26, LEFT([Shown], 25) & "...", [Shown])
                    VAR NameText = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(NameRaw, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "%", "%25"), "#", "%23")
                    VAR TypeText = IF(ISBLANK(EnvType), "Unknown", EnvType)
                    VAR DotCount = MIN([AgentsHere], 8)
                    VAR DotSvg = IF(DotCount > 0, CONCATENATEX(GENERATESERIES(1, DotCount), "<circle cx='" & (258 + ([Value] - 1) * 9) & "' cy='" & (RowTop + 11) & "' r='3.6' fill='" & DotInk & "'/>", ""))
                    VAR MoreDots = IF([AgentsHere] > 8, "<text x='" & (258 + 8 * 9) & "' y='" & (RowTop + 14.5) & "' " & Font & " font-size='9' fill='%235B6B78'>+" & ([AgentsHere] - 8) & "</text>")
                    RETURN
                        "<text x='0' y='" & (RowTop + 14.5) & "' " & Font & " font-size='10.5'" & WeightAttr & " fill='" & NameInk & "'>" & NameText & "</text>"
                            & "<text x='182' y='" & (RowTop + 14.5) & "' " & Font & " font-size='9.5' fill='%235B6B78'>" & TypeText & "</text>"
                            & DotSvg & MoreDots
                            & "<line x1='0' y1='" & (RowTop + 21.3) & "' x2='300' y2='" & (RowTop + 21.3) & "' stroke='%23EEF1F4'/>",
                    "",
                    [RowNo], ASC
                )
            RETURN IF(COUNTROWS(Ranked) > 0, "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='264' viewBox='0 0 300 132'>" & EnvRowsSvg & "</svg>")
        displayFolder: Agent passports
        dataCategory: ImageUrl
        lineageTag: 5113a2d5-bca3-51f6-aef3-230c0a6097ad

    /// ONE FIX title: turn on sign-in for the agents open to anyone (or, if none, the live agents with no sign-in), else narrow the whole-tenant agents.
    measure 'Passport One Fix Title' =
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR WorstConcern = MIN(AgentsCurrent[Passport Concern])
            VAR Picked = FILTER(AgentsCurrent, AgentsCurrent[Passport Concern] = WorstConcern)
            VAR PickedCount = COUNTROWS(Picked) + 0
            VAR Listed =
                ADDCOLUMNS(
                    Picked,
                    "Shown", IF(Mode = "Anonymize", AgentsCurrent[Pseudonym], AgentsCurrent[DisplayName]),
                    "Nth", VAR ThisOrder = AgentsCurrent[Passport Order] RETURN COUNTROWS(FILTER(Picked, AgentsCurrent[Passport Order] <= ThisOrder))
                )
            VAR NameList = CONCATENATEX(Listed, [Shown] & IF([Nth] = PickedCount - 1, " and ", IF([Nth] < PickedCount - 1, ", ", "")), "", AgentsCurrent[Passport Order], ASC)
            RETURN
                SWITCH(
                    TRUE(),
                    ISBLANK(WorstConcern), BLANK(),
                    WorstConcern <= 2, "Turn on sign-in for " & NameList,
                    WorstConcern = 3, "Share " & NameList & " with named people or groups, not the whole tenant",
                    "No live agent is open to anyone or to the whole tenant"
                )
        displayFolder: Agent passports
        lineageTag: 929d5a0d-1948-5f06-aab2-5e11720062f9

    /// Line 1 of the ONE FIX title. A card does not wrap its value onto a second line, so the title breaks at the last space before 42 characters.
    measure 'Passport One Fix Title Line 1' = 
            VAR TitleText = [Passport One Fix Title]
            VAR BreakAt = IF(LEN(TitleText) <= 42, 0, MAXX(FILTER(GENERATESERIES(1, 43), MID(TitleText, [Value], 1) = " "), [Value]) + 0)
            RETURN IF(BreakAt > 0, LEFT(TitleText, BreakAt - 1), TitleText)
        displayFolder: Agent passports
        lineageTag: 1515a0d6-6411-590a-af67-6b75cdccfa71

    /// Line 2 of the ONE FIX title. A card does not wrap its value onto a second line, so the title breaks at the last space before 42 characters.
    measure 'Passport One Fix Title Line 2' = 
            VAR TitleText = [Passport One Fix Title]
            VAR BreakAt = IF(LEN(TitleText) <= 42, 0, MAXX(FILTER(GENERATESERIES(1, 43), MID(TitleText, [Value], 1) = " "), [Value]) + 0)
            RETURN IF(BreakAt > 0, MID(TitleText, BreakAt + 1, 500))
        displayFolder: Agent passports
        lineageTag: 1ffae300-c7a1-5563-ad95-f6acf375a91d

    /// ONE FIX detail: where the agents in the title sit and what to do after the fix.
    measure 'Passport One Fix Detail' =
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR WorstConcern = MIN(AgentsCurrent[Passport Concern])
            VAR Picked = FILTER(AgentsCurrent, AgentsCurrent[Passport Concern] = WorstConcern)
            VAR PickedCount = COUNTROWS(Picked) + 0
            VAR SameEnvironment = COUNTROWS(SUMMARIZE(Picked, AgentsCurrent[EnvironmentId])) = 1
            VAR EnvKey = MAXX(Picked, AgentsCurrent[EnvironmentId])
            VAR EnvType = MAXX(Picked, AgentsCurrent[Environment Type])
            VAR EnvName = CALCULATE([Environment Display Name], TREATAS({EnvKey}, EnvironmentsCurrent[EnvironmentId]))
            VAR PersonalOwner = IF(Mode <> "Anonymize" && RIGHT(EnvName, 9) = " personal", LEFT(EnvName, LEN(EnvName) - 9))
            VAR EnvPhrase =
                SWITCH(
                    TRUE(),
                    NOT SameEnvironment || ISBLANK(EnvName), "",
                    EnvType = "Developer" && NOT ISBLANK(PersonalOwner), ", in " & PersonalOwner & "'s personal environment",
                    EnvType = "Developer", ", in a personal environment (" & EnvName & ")",
                    ", in the " & EnvName & " environment"
                )
            VAR Subject = IF(PickedCount = 1, "It", IF(PickedCount = 2, "Both", "All " & FORMAT(PickedCount, "#,0")))
            VAR Them = IF(PickedCount = 1, "it", "them")
            VAR MoveOn = IF(SameEnvironment && EnvType IN {"Developer", "Trial"}, " Then move " & Them & " to Production.", "")
            RETURN
                SWITCH(
                    TRUE(),
                    ISBLANK(WorstConcern), BLANK(),
                    WorstConcern = 1, Subject & IF(PickedCount = 1, " sits", " sit") & " on a public website with no sign-in" & EnvPhrase & "." & MoveOn,
                    WorstConcern = 2, Subject & IF(PickedCount = 1, " is", " are") & " live with no sign-in" & EnvPhrase & ", so nobody who uses " & Them & " is identified." & MoveOn,
                    WorstConcern = 3, Subject & IF(PickedCount = 1, " is", " are") & " live and shared with everyone in the tenant" & EnvPhrase & "." & MoveOn,
                    "Every live agent asks for sign-in and is shared with named people or groups."
                )
        displayFolder: Agent passports
        lineageTag: 0ddb0ee5-865f-5519-a5b8-e50cca8729f5

    /// RECORDS DISAGREE: drafts in the inventory that agent-audit-events.csv shows being published.
    measure 'Records Disagree Detail' =
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR AuditRows = COUNTROWS(ALL(AgentAuditEvents)) + 0
            VAR Picked = FILTER(AgentsCurrent, AgentsCurrent[Audit Says Published] && NOT ISBLANK(AgentsCurrent[IsPublished]) && NOT AgentsCurrent[IsPublished])
            VAR PickedCount = COUNTROWS(Picked) + 0
            VAR Listed =
                ADDCOLUMNS(
                    Picked,
                    "Shown", IF(Mode = "Anonymize", AgentsCurrent[Pseudonym], AgentsCurrent[DisplayName]),
                    "Nth", VAR ThisOrder = AgentsCurrent[Passport Order] RETURN COUNTROWS(FILTER(Picked, AgentsCurrent[Passport Order] <= ThisOrder))
                )
            VAR NameList = CONCATENATEX(Listed, [Shown] & IF([Nth] = PickedCount - 1, " and ", IF([Nth] < PickedCount - 1, ", ", "")), "", AgentsCurrent[Passport Order], ASC)
            VAR Them = IF(PickedCount = 1, "it", "them")
            RETURN
                SWITCH(
                    TRUE(),
                    ISEMPTY(AgentsCurrent), BLANK(),
                    AuditRows = 0, "agent-audit-events.csv has no rows, so the inventory's publish state cannot be checked against the audit log.",
                    PickedCount = 0, "The audit log and the inventory agree on which agents are published.",
                    "The audit log shows " & NameList & " being published. The inventory says " & IF(PickedCount = 1, "it is a draft", IF(PickedCount = 2, "both are drafts", "all " & FORMAT(PickedCount, "#,0") & " are drafts"))
                        & ". Check who published " & Them & " and where."
                )
        displayFolder: Agent passports
        lineageTag: d799acc8-df47-5a9d-a190-8adaf7b6f819

    /// Footer sources. Adds "sample data, example.com" only when the Dataverse URLs are example.com, as in samples/.
    measure 'Passport Sources' =
            VAR IsSample = COUNTROWS(FILTER(ALL(AgentComponents[DataverseUrl]), CONTAINSSTRING(AgentComponents[DataverseUrl], "example.com"))) > 0
            RETURN "Sources: agents.csv · environments.csv · agent-components.csv · agent-audit-events.csv" & IF(IsSample, " · sample data, example.com")
        displayFolder: Agent passports
        lineageTag: e4242503-13ba-5559-a0f3-89678741147b

    partition AgentsCurrent = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\agents.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                ParseUtc = (value as nullable text) as nullable datetime =>
                    if value = null then null else DateTime.FromText(value, [Format="yyyy-MM-dd'T'HH:mm:ss'Z'", Culture="en-US"]),
                Parsed = Table.TransformColumns(Cleaned, {{"CreatedAt", ParseUtc, type datetime}, {"LastPublishedAt", ParseUtc, type datetime}}),
                #"Changed Type" = Table.TransformColumnTypes(Parsed, {{"RunDate", type date}, {"ViewerUserCount", Int64.Type}, {"ViewerGroupCount", Int64.Type}, {"EditorUserCount", Int64.Type}, {"EditorGroupCount", Int64.Type}, {"ListedConnectorCount", Int64.Type}, {"ListedConnectorOperationCount", Int64.Type}, {"CapabilitiesDistinctConnectors", Int64.Type}, {"CapabilitiesDistinctConnectorOperations", Int64.Type}, {"IsPublished", type logical}, {"IsQuarantined", type logical}, {"IsManaged", type logical}, {"ViewerEntireTenant", type logical}, {"IsWebSearchEnabledForKnowledge", type logical}}),
                Selected = Table.SelectColumns(#"Changed Type", {"RunDate", "EnvironmentId", "AgentId", "DisplayName", "Harness", "CreatedIn", "CreatedAt", "CreatedBy", "OwnerId", "LastPublishedAt", "IsPublished", "IsQuarantined", "IsManaged", "Orchestration", "Model", "Authentication", "Channels", "ViewerUserCount", "ViewerGroupCount", "ViewerEntireTenant", "EditorUserCount", "EditorGroupCount", "ListedConnectorCount", "ListedConnectorOperationCount", "CapabilitiesDistinctConnectors", "CapabilitiesDistinctConnectorOperations", "IsWebSearchEnabledForKnowledge"}),
                // Blank cells are null. List.Max includes nulls by default and can
                // return null, and the row filter then keeps nothing.
                LatestRunDate = List.Max(List.RemoveNulls(Selected[RunDate])),
                Latest = Table.SelectRows(Selected, each [RunDate] = LatestRunDate)
            in
                Latest

    annotation PBI_ResultType = Table
