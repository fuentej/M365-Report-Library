    column PseudonymNumber = 
            VAR IdText = AgentsCurrent[AgentId]
            VAR CharCount = LEN(IdText)
            VAR HashSeed = SUMX(GENERATESERIES(1, CharCount), UNICODE(MID(IdText, [Value], 1)) * [Value])
            RETURN MOD(HashSeed, 9000) + 1000
        dataType: int64
        formatString: 0000
        lineageTag: 904e41f4-70a1-514b-a883-3d9a46f4d73c
        summarizeBy: none
        isDataTypeInferred: false

    column Pseudonym = "Agent " & FORMAT(AgentsCurrent[PseudonymNumber], "0000")
        dataType: string
        lineageTag: b0d30bc9-df77-5618-89f0-6677d816dc89
        summarizeBy: none
        isDataTypeInferred: false





    /// The agent's environment type (Developer, Trial, Sandbox, Default, Production) from the latest environments.csv run. Blank when the environment is not in that run.
    column 'Environment Type' = LOOKUPVALUE(EnvironmentsCurrent[EnvironmentType], EnvironmentsCurrent[EnvironmentId], AgentsCurrent[EnvironmentId])
        dataType: string
        isHidden
        lineageTag: b6f27851-40be-5e61-a19f-f616b64aeb97
        summarizeBy: none
        isDataTypeInferred: false

    /// True when agent-audit-events.csv holds a BotPublish event for the agent.
    column 'Audit Says Published' = COUNTROWS(FILTER(RELATEDTABLE(AgentAuditEvents), AgentAuditEvents[Operation] = "BotUpdateOperation-BotPublish")) > 0
        dataType: boolean
        isHidden
        lineageTag: 37e3a1d3-7120-556e-ad9a-73409c1ec833
        summarizeBy: none
        isDataTypeInferred: false

    /// The worst thing about the agent, 1 (needs a look first) to 7 (nothing found). 1 live with no sign-in on the Website channel (anyone with the link); 2 live with no sign-in; 3 live and shared with the whole tenant; 4 a draft with no sign-in; 5 a draft the audit log shows being published; 6 in a personal (Developer) or Trial environment; 7 none of these. 1 to 3 are red on the page, 4 to 6 amber.
    column 'Passport Concern' =
            VAR Live = AgentsCurrent[IsPublished] = TRUE()
            VAR Draft = NOT ISBLANK(AgentsCurrent[IsPublished]) && NOT AgentsCurrent[IsPublished]
            VAR NoSignIn = AgentsCurrent[Authentication] = "None"
            VAR OnWebsite = CONTAINSSTRING(AgentsCurrent[Channels], "Website")
            VAR WholeTenant = AgentsCurrent[ViewerEntireTenant] = TRUE()
            VAR PersonalOrTrial = AgentsCurrent[Environment Type] IN {"Developer", "Trial"}
            RETURN
                SWITCH(
                    TRUE(),
                    Live && NoSignIn && OnWebsite, 1,
                    Live && NoSignIn, 2,
                    Live && WholeTenant, 3,
                    NoSignIn, 4,
                    Draft && AgentsCurrent[Audit Says Published], 5,
                    PersonalOrTrial, 6,
                    7
                )
        dataType: int64
        formatString: 0
        isHidden
        lineageTag: dfa94f20-2e97-5499-a4af-c27101405eef
        summarizeBy: none
        isDataTypeInferred: false

    /// Sort key behind Passport Order: concern first, then live before draft, then most viewers.
    column 'Passport Sort Key' = AgentsCurrent[Passport Concern] * 1000000 + IF(AgentsCurrent[IsPublished] = TRUE(), 0, 100000) + 99999 - MIN(COALESCE(AgentsCurrent[ViewerUserCount], 0), 99999)
        dataType: int64
        formatString: 0
        isHidden
        lineageTag: 8ed54ffc-a36c-5d71-a819-32bae524d9fb
        summarizeBy: none
        isDataTypeInferred: false

    /// Where the agent's passport sits on the page, 1 (top left) to 12, worst first: Passport Sort Key, then name, then AgentId.
    column 'Passport Order' =
            VAR ThisKey = AgentsCurrent[Passport Sort Key]
            VAR ThisName = AgentsCurrent[DisplayName]
            VAR ThisId = AgentsCurrent[AgentId]
            VAR Others = ALL(AgentsCurrent[Passport Sort Key], AgentsCurrent[DisplayName], AgentsCurrent[AgentId])
            RETURN
                COUNTROWS(
                    FILTER(
                        Others,
                        AgentsCurrent[Passport Sort Key] < ThisKey
                            || (AgentsCurrent[Passport Sort Key] = ThisKey && (AgentsCurrent[DisplayName] < ThisName || (AgentsCurrent[DisplayName] = ThisName && AgentsCurrent[AgentId] < ThisId)))
                    )
                ) + 1
        dataType: int64
        formatString: 0
        isHidden
        lineageTag: 682d43b9-1f4d-518e-acbd-052801b8cc4d
        summarizeBy: none
        isDataTypeInferred: false

    /// A stable AgentId-derived pseudonym when Anonymize is selected.
    measure 'Agent Display Name' = 
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR RealName = SELECTEDVALUE(AgentsCurrent[DisplayName])
            VAR Pseudo = SELECTEDVALUE(AgentsCurrent[Pseudonym])
            RETURN IF(Mode = "Anonymize", Pseudo, RealName)
        lineageTag: b68043b8-1e3e-5ba4-81c5-a3e7fde92c9d





    /// The run line on the header band: latest agents.csv run date, agents in it and environments in the latest environments.csv run.
    measure 'Passport Run Header' =
            VAR RunDay = MAX(AgentsCurrent[RunDate])
            VAR AgentTotal = COUNTROWS(AgentsCurrent) + 0
            VAR EnvTotal = COUNTROWS(EnvironmentsCurrent) + 0
            RETURN
                IF(
                    ISBLANK(RunDay),
                    "agents.csv has no rows",
                    "Run " & FORMAT(RunDay, "yyyy-MM-dd") & " · " & FORMAT(AgentTotal, "#,0") & IF(AgentTotal = 1, " agent, ", " agents, ")
                        & FORMAT(EnvTotal, "#,0") & IF(EnvTotal = 1, " environment", " environments")
                )
        displayFolder: Agent passports
        lineageTag: 2022c962-81e7-54d6-a02a-58f08596a0e2

    /// Published agents out of all agents in the latest run, "n of N". Blank when agents.csv has no rows.
    measure 'Published Of Agents' =
            VAR AgentTotal = [Agent Count]
            RETURN IF(ISBLANK(AgentTotal), BLANK(), FORMAT([Published Agents] + 0, "#,0") & " of " & FORMAT(AgentTotal, "#,0"))
        displayFolder: Agent passports
        lineageTag: 37694e5f-0973-5f53-a3f4-5b10aa389341

    /// Live agents with no sign-in on the Website channel: anyone with the link can use them (Passport Concern 1).
    measure 'Open To Anyone' = IF(ISEMPTY(AgentsCurrent), BLANK(), COUNTROWS(FILTER(AgentsCurrent, AgentsCurrent[Passport Concern] = 1)) + 0)
        formatString: #,0
        displayFolder: Agent passports
        lineageTag: ba0e57f5-10de-5e43-a89f-7ca0ead40656

    /// Agents in a personal (Developer) or Trial environment.
    measure 'Agents In Personal Or Trial' = IF(ISEMPTY(AgentsCurrent), BLANK(), COUNTROWS(FILTER(AgentsCurrent, AgentsCurrent[Environment Type] IN {"Developer", "Trial"})) + 0)
        formatString: #,0
        displayFolder: Agent passports
        lineageTag: 0267a8f6-ad2f-5245-a778-a1a6eef6cd0d

    /// Agents with a red passport (Passport Concern 1 to 3): live and open to anyone, live with no sign-in, or live and shared with the whole tenant.
    measure 'Agents Needing A Look' = IF(ISEMPTY(AgentsCurrent), BLANK(), COUNTROWS(FILTER(AgentsCurrent, AgentsCurrent[Passport Concern] <= 3)) + 0)
        formatString: #,0
        displayFolder: Agent passports
        lineageTag: ffa98abb-0991-58a5-a43b-6836a5d355c2

    /// The headline sentence: red passports out of all agents, then how many are open to anyone and whether they sit in one person's personal environment.
    measure 'Passport Headline' =
            VAR AgentTotal = COUNTROWS(AgentsCurrent) + 0
            VAR NeedLook = [Agents Needing A Look]
            VAR OpenCount = [Open To Anyone]
            VAR OpenAgents = FILTER(AgentsCurrent, AgentsCurrent[Passport Concern] = 1)
            VAR OpenPersonal = COUNTROWS(FILTER(OpenAgents, AgentsCurrent[Environment Type] = "Developer")) + 0
            VAR OpenEnvironments = COUNTROWS(SUMMARIZE(OpenAgents, AgentsCurrent[EnvironmentId])) + 0
            VAR FirstSentence =
                IF(
                    NeedLook = 0,
                    "No agent needs a look.",
                    FORMAT(NeedLook, "#,0") & " of " & FORMAT(AgentTotal, "#,0") & IF(NeedLook = 1, " agent needs", " agents need") & " a look."
                )
            VAR WhereFrom =
                IF(
                    OpenPersonal = OpenCount,
                    IF(OpenEnvironments = 1, ", from one person's private environment", ", from people's private environments")
                )
            VAR SecondSentence =
                IF(
                    OpenCount > 0,
                    " " & FORMAT(OpenCount, "#,0") & IF(OpenCount = 1, " answers", " answer") & " anyone on the internet, with no sign-in" & WhereFrom & "."
                )
            RETURN IF(AgentTotal = 0, BLANK(), FirstSentence & SecondSentence)
        displayFolder: Agent passports
        lineageTag: b37dcbb5-1877-5b22-a926-39d87528b441

    /// One agent's passport as an SVG image (224 x 170 canvas px): name, live or draft, environment and its type, sign-in, channels, reach, editors, connectors and risky components, last publish date and owner. Blank unless one agent is in context. Names follow the Anonymize toggle.
    measure 'Passport Card' =
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR Snap = [Agents Snapshot Date]
            VAR Font = "font-family='Segoe UI, sans-serif'"
            VAR LabelStyle = Font & " font-size='10' fill='%235B6B78'"
            VAR PlainStyle = Font & " font-size='10' fill='%231F2A33'"
            VAR RedStyle = Font & " font-size='10' font-weight='600' fill='%23C62828'"
            VAR RawName = [Agent Display Name]
            VAR NameShort = IF(LEN(RawName) > 24, LEFT(RawName, 23) & "...", RawName)
            VAR NameText = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(NameShort, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "%", "%25"), "#", "%23")
            VAR EnvKey = SELECTEDVALUE(AgentsCurrent[EnvironmentId])
            VAR EnvRaw = CALCULATE([Environment Display Name], TREATAS({EnvKey}, EnvironmentsCurrent[EnvironmentId]))
            VAR EnvShown = IF(ISBLANK(EnvRaw), "Unknown environment", EnvRaw)
            VAR EnvShort = IF(LEN(EnvShown) > 26, LEFT(EnvShown, 25) & "...", EnvShown)
            VAR EnvText = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(EnvShort, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "%", "%25"), "#", "%23")
            VAR EnvType = SELECTEDVALUE(AgentsCurrent[Environment Type])
            VAR TagText = SWITCH(EnvType, "Developer", "PERSONAL", "Trial", "TRIAL", "Sandbox", "SANDBOX")
            VAR TagInk = SWITCH(EnvType, "Developer", "%23C62828", "Trial", "%23A86A00", "%235B6B78")
            VAR TagFill = SWITCH(EnvType, "Developer", "%23FBE3E3", "Trial", "%23FDF0D5", "%23EEF1F4")
            VAR TagX = ROUND(10 + LEN(EnvShort) * 5.3 + 5, 0)
            VAR TagWidth = ROUND(LEN(TagText) * 5.4 + 8, 0)
            VAR Concern = SELECTEDVALUE(AgentsCurrent[Passport Concern])
            VAR BarColor = IF(Concern <= 3, "%23C62828", IF(Concern <= 6, "%23D98A00", "%23D5DCE2"))
            VAR Published = SELECTEDVALUE(AgentsCurrent[IsPublished])
            VAR StateText = IF(ISBLANK(Published), "UNKNOWN", IF(Published, "LIVE", "DRAFT"))
            VAR StateInk = IF(StateText = "LIVE", "%232E7D32", "%235B6B78")
            VAR StateFill = IF(StateText = "LIVE", "%23E8F3E9", "%23EEF1F4")
            VAR StateWidth = ROUND(LEN(StateText) * 6 + 10, 0)
            VAR Auth = SELECTEDVALUE(AgentsCurrent[Authentication])
            VAR ChannelList = SELECTEDVALUE(AgentsCurrent[Channels])
            VAR SignInText = SWITCH(TRUE(), ISBLANK(Auth), "Unknown", Auth = "Generic OAuth 2.0", "OAuth", Auth)
            VAR IsPublic = Auth = "None" && CONTAINSSTRING(ChannelList, "Website")
            VAR WhereRaw = IF(ISBLANK(ChannelList), "Unknown", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(ChannelList, ";", ", "), "&", "&amp;"), "<", "&lt;"))
            VAR WhereBreak = IF(LEN(WhereRaw) <= 29, 0, MAXX(FILTER(GENERATESERIES(1, 30), MID(WhereRaw, [Value], 1) = " "), [Value]) + 0)
            VAR Where1 = IF(WhereBreak > 0, LEFT(WhereRaw, WhereBreak - 1), WhereRaw)
            VAR Where2 = IF(WhereBreak > 0, MID(WhereRaw, WhereBreak + 1, 200), "")
            VAR ViewerUsers = SELECTEDVALUE(AgentsCurrent[ViewerUserCount])
            VAR ViewerGroups = SELECTEDVALUE(AgentsCurrent[ViewerGroupCount])
            VAR Tenant = SELECTEDVALUE(AgentsCurrent[ViewerEntireTenant])
            VAR PeoplePart = IF(ISBLANK(ViewerUsers), "", FORMAT(ViewerUsers, "#,0") & IF(ViewerUsers = 1, " person", " people"))
            VAR GroupPart = IF(ViewerGroups > 0, FORMAT(ViewerGroups, "#,0") & IF(ViewerGroups = 1, " group", " groups"), "")
            VAR NamedReach = PeoplePart & IF(PeoplePart <> "" && GroupPart <> "", ", ", "") & GroupPart
            VAR ReachRaw =
                SWITCH(
                    TRUE(),
                    IsPublic, "Anyone with the link",
                    Tenant = TRUE(), IF(NamedReach = "", "Whole tenant", NamedReach & " + whole tenant"),
                    NamedReach = "", "Unknown",
                    NamedReach
                )
            VAR ReachRed = IsPublic || Tenant = TRUE()
            VAR ReachBreak = IF(LEN(ReachRaw) <= 29, 0, MAXX(FILTER(GENERATESERIES(1, 30), MID(ReachRaw, [Value], 1) = " "), [Value]) + 0)
            VAR Reach1 = IF(ReachBreak > 0, LEFT(ReachRaw, ReachBreak - 1), ReachRaw)
            VAR Reach2 = IF(ReachBreak > 0, MID(ReachRaw, ReachBreak + 1, 200), "")
            VAR EditorUsers = SELECTEDVALUE(AgentsCurrent[EditorUserCount])
            VAR EditorGroups = SELECTEDVALUE(AgentsCurrent[EditorGroupCount])
            VAR EditorPeople = IF(EditorUsers > 0, FORMAT(EditorUsers, "#,0") & IF(EditorUsers = 1, " person", " people"), "")
            VAR EditorGroupPart = IF(EditorGroups > 0, FORMAT(EditorGroups, "#,0") & IF(EditorGroups = 1, " group", " groups"), "")
            VAR EditorsText =
                SWITCH(
                    TRUE(),
                    ISBLANK(EditorUsers) && ISBLANK(EditorGroups), "Unknown",
                    EditorPeople = "" && EditorGroupPart = "", "owner only",
                    EditorPeople & IF(EditorPeople <> "" && EditorGroupPart <> "", ", ", "") & EditorGroupPart
                )
            VAR Y1 = 54
            VAR Y2 = Y1 + 12.8
            VAR Y3 = Y2 + 12.8 + IF(Where2 <> "", 12.8, 0)
            VAR Y4 = Y3 + 12.8 + IF(Reach2 <> "", 12.8, 0)
            VAR FactLines =
                "<text x='10' y='" & Y1 & "' " & LabelStyle & ">Sign-in</text><text x='52' y='" & Y1 & "' " & IF(Auth = "None", RedStyle, PlainStyle) & ">" & SignInText & "</text>"
                    & "<text x='10' y='" & Y2 & "' " & LabelStyle & ">Where</text><text x='52' y='" & Y2 & "' " & PlainStyle & ">" & Where1 & "</text>"
                    & IF(Where2 <> "", "<text x='52' y='" & (Y2 + 12.8) & "' " & PlainStyle & ">" & Where2 & "</text>")
                    & "<text x='10' y='" & Y3 & "' " & LabelStyle & ">Reach</text><text x='52' y='" & Y3 & "' " & IF(ReachRed, RedStyle, PlainStyle) & ">" & Reach1 & "</text>"
                    & IF(Reach2 <> "", "<text x='52' y='" & (Y3 + 12.8) & "' " & IF(ReachRed, RedStyle, PlainStyle) & ">" & Reach2 & "</text>")
                    & "<text x='10' y='" & Y4 & "' " & LabelStyle & ">Editors</text><text x='52' y='" & Y4 & "' " & PlainStyle & ">" & EditorsText & "</text>"
            VAR Connectors = SELECTEDVALUE(AgentsCurrent[CapabilitiesDistinctConnectors])
            VAR ConnectorText = IF(ISBLANK(Connectors), "connectors unknown", FORMAT(Connectors, "#,0") & IF(Connectors = 1, " connector", " connectors"))
            VAR ComponentSnap = [Agent Components Snapshot Date]
            VAR HasHttp = CALCULATE(COUNTROWS(AgentComponents), AgentComponents[RunDate] = ComponentSnap, AgentComponents[Category] = "HttpRequest") > 0
            VAR HasPrompt = CALCULATE(COUNTROWS(AgentComponents), AgentComponents[RunDate] = ComponentSnap, AgentComponents[Category] = "Prompt") > 0
            VAR HasMcp = CALCULATE(COUNTROWS(AgentComponents), AgentComponents[RunDate] = ComponentSnap, AgentComponents[Category] = "Mcp") > 0
            VAR HasWebSearch = SELECTEDVALUE(AgentsCurrent[IsWebSearchEnabledForKnowledge]) = TRUE()
            VAR ChipList =
                FILTER(
                    UNION(
                        ROW("Pos", 1, "Label", ConnectorText, "Hot", 0, "Shown", 1),
                        ROW("Pos", 2, "Label", "HTTP", "Hot", 1, "Shown", IF(HasHttp, 1, 0)),
                        ROW("Pos", 3, "Label", "Prompt", "Hot", 0, "Shown", IF(HasPrompt, 1, 0)),
                        ROW("Pos", 4, "Label", "MCP", "Hot", 1, "Shown", IF(HasMcp, 1, 0)),
                        ROW("Pos", 5, "Label", "Web search", "Hot", 0, "Shown", IF(HasWebSearch, 1, 0))
                    ),
                    [Shown] = 1
                )
            VAR ChipSized = ADDCOLUMNS(ChipList, "Wide", ROUND(LEN([Label]) * 5.2 + 12, 0))
            VAR ChipEnds = ADDCOLUMNS(ChipSized, "EndAt", VAR ThisPos = [Pos] RETURN SUMX(FILTER(ChipSized, [Pos] <= ThisPos), [Wide] + 4))
            VAR WrapFrom = MINX(FILTER(ChipEnds, [EndAt] - 4 > 204), [EndAt] - [Wide] - 4)
            VAR TwoChipRows = NOT ISBLANK(WrapFrom)
            VAR ChipSvg =
                CONCATENATEX(
                    ChipEnds,
                    VAR StartAt = [EndAt] - [Wide] - 4
                    VAR OnSecond = TwoChipRows && StartAt >= WrapFrom
                    VAR ChipX = 10 + StartAt - IF(OnSecond, WrapFrom, 0)
                    VAR ChipY = IF(TwoChipRows && NOT OnSecond, 115, 133)
                    RETURN
                        "<rect x='" & ChipX & "' y='" & ChipY & "' width='" & [Wide] & "' height='14' fill='%23FFFFFF' stroke='" & IF([Hot] = 1, "%23D98A00", "%23C5CED6") & "'/>"
                            & "<text x='" & (ChipX + [Wide] / 2) & "' y='" & (ChipY + 10.2) & "' text-anchor='middle' " & Font & " font-size='9' fill='%233D4C58'>" & [Label] & "</text>",
                    "",
                    [Pos], ASC
                )
            VAR LastPublished = SELECTEDVALUE(AgentsCurrent[LastPublishedAt])
            VAR PublishedText = IF(NOT ISBLANK(LastPublished), "Published " & FORMAT(LastPublished, "yyyy-MM-dd"), IF(StateText = "DRAFT", "Never published", "Publish date unknown"))
            VAR OwnerKey = SELECTEDVALUE(AgentsCurrent[OwnerId])
            VAR OwnerPseudo = CALCULATE(MAX(Agents[OwnerPseudonym]), Agents[RunDate] = Snap)
            VAR OwnerText = IF(ISBLANK(OwnerKey), "owner unknown", IF(Mode = "Anonymize", "owner " & OwnerPseudo, "owner id " & LEFT(OwnerKey, 4) & "..."))
            RETURN
                IF(
                    HASONEVALUE(AgentsCurrent[AgentId]),
                    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='448' height='340' viewBox='0 0 224 170'>"
                        & "<rect x='0.5' y='0.5' width='223' height='169' fill='%23FFFFFF' stroke='%23D5DCE2'/>"
                        & "<rect x='0' y='0' width='224' height='4' fill='" & BarColor & "'/>"
                        & "<text x='10' y='22' " & Font & " font-size='12.5' font-weight='600' fill='%231F2A33'>" & NameText & "</text>"
                        & "<rect x='" & (214 - StateWidth) & "' y='10' width='" & StateWidth & "' height='14' fill='" & StateFill & "'/>"
                        & "<text x='" & (214 - StateWidth / 2) & "' y='20.3' text-anchor='middle' " & Font & " font-size='8.5' font-weight='600' fill='" & StateInk & "'>" & StateText & "</text>"
                        & "<text x='10' y='37' " & Font & " font-size='10' fill='%233D4C58'>" & EnvText & "</text>"
                        & IF(
                            NOT ISBLANK(TagText),
                            "<rect x='" & TagX & "' y='28.5' width='" & TagWidth & "' height='11' fill='" & TagFill & "'/>"
                                & "<text x='" & (TagX + TagWidth / 2) & "' y='36.8' text-anchor='middle' " & Font & " font-size='7.5' font-weight='600' fill='" & TagInk & "'>" & TagText & "</text>"
                        )
                        & FactLines
                        & ChipSvg
                        & "<text x='10' y='159' " & Font & " font-size='8.5' fill='%238795A1'>" & PublishedText & " %C2%B7 " & OwnerText & "</text>"
                        & "</svg>"
                )
        displayFolder: Agent passports
        dataCategory: ImageUrl
        lineageTag: 359a4e17-e911-5787-aa40-80c80da89f1a

