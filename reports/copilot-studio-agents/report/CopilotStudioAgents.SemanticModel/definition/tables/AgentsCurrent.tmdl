        sourceColumn: IsWebSearchEnabledForKnowledge

    column PseudonymNumber = 
            VAR IdText = AgentsCurrent[AgentId]
            VAR CharCount = LEN(IdText)
            VAR HashSeed = SUMX(GENERATESERIES(1, CharCount), UNICODE(MID(IdText, [Value], 1)) * [Value])
            RETURN MOD(HashSeed, 9000) + 1000
        dataType: int64
        formatString: 0000
        lineageTag: 904e41f4-70a1-514b-a883-3d9a46f4d73c
        summarizeBy: none
        isDataTypeInferred: false

    column Pseudonym = "Agent " & FORMAT(AgentsCurrent[PseudonymNumber], "0000")
        dataType: string
        lineageTag: b0d30bc9-df77-5618-89f0-6677d816dc89
        summarizeBy: none
        isDataTypeInferred: false

    /// A stable AgentId-derived pseudonym when Anonymize is selected.
    measure 'Agent Display Name' = 
            VAR Mode = SELECTEDVALUE(AnonymizeMode[Mode], "Show names")
            VAR RealName = SELECTEDVALUE(AgentsCurrent[DisplayName])
            VAR Pseudo = SELECTEDVALUE(AgentsCurrent[Pseudonym])
            RETURN IF(Mode = "Anonymize", Pseudo, RealName)
        lineageTag: b68043b8-1e3e-5ba4-81c5-a3e7fde92c9d

    partition AgentsCurrent = calculated
        mode: import
        source =
            SELECTCOLUMNS(
                FILTER(Agents, Agents[RunDate] = MAX(Agents[RunDate])),
                "RunDate", Agents[RunDate],
                "EnvironmentId", Agents[EnvironmentId],
                "AgentId", Agents[AgentId],
                "DisplayName", Agents[DisplayName],
                "Harness", Agents[Harness],
                "CreatedIn", Agents[CreatedIn],
                "CreatedAt", Agents[CreatedAt],
                "CreatedBy", Agents[CreatedBy],
                "OwnerId", Agents[OwnerId],
                "LastPublishedAt", Agents[LastPublishedAt],
                "IsPublished", Agents[IsPublished],
                "IsQuarantined", Agents[IsQuarantined],
                "IsManaged", Agents[IsManaged],
                "Orchestration", Agents[Orchestration],
                "Model", Agents[Model],
                "Authentication", Agents[Authentication],
                "Channels", Agents[Channels],
                "ViewerUserCount", Agents[ViewerUserCount],
                "ViewerGroupCount", Agents[ViewerGroupCount],
                "ViewerEntireTenant", Agents[ViewerEntireTenant],
                "EditorUserCount", Agents[EditorUserCount],
                "EditorGroupCount", Agents[EditorGroupCount],
                "ListedConnectorCount", Agents[ListedConnectorCount],
                "ListedConnectorOperationCount", Agents[ListedConnectorOperationCount],
                "CapabilitiesDistinctConnectors", Agents[CapabilitiesDistinctConnectors],
                "CapabilitiesDistinctConnectorOperations", Agents[CapabilitiesDistinctConnectorOperations],
                "IsWebSearchEnabledForKnowledge", Agents[IsWebSearchEnabledForKnowledge]
            )

    annotation PBI_ResultType = Table
