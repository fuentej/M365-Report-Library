        lineageTag: bccc05cb-77a7-5c25-a04c-f33e4b81cfd5
        summarizeBy: none
        sourceColumn: ExternalUserStateChangeDateTime

    column AccountEnabled
        dataType: boolean
        lineageTag: defcf43c-396c-51ce-be92-861459ad4d06
        summarizeBy: none
