table GuestsCurrent
    lineageTag: fd3abb23-ba61-5ed3-963e-f86583e0efb0

    column RunDate
        dataType: dateTime
        formatString: Short Date
        lineageTag: d71e5832-bc24-569f-95fa-337d74c65def
        summarizeBy: none
        sourceColumn: RunDate

    column Id
        dataType: string
        lineageTag: cafa92ba-e4a6-5e4a-80c4-cfa3af4396b1
        summarizeBy: none
        sourceColumn: Id

    column DisplayName
        dataType: string
        lineageTag: 9d356b11-30e2-5c5b-bbc8-4b962c17f448
        summarizeBy: none
        sourceColumn: DisplayName

    column Mail
        dataType: string
        lineageTag: ae16752a-2e75-5980-af12-e2742790fe5a
        summarizeBy: none
        sourceColumn: Mail

    column UserPrincipalName
        dataType: string
        lineageTag: 62aebe2d-0a14-5ebe-a152-bc3a8c089240
        summarizeBy: none
        sourceColumn: UserPrincipalName

    column ExternalDomain
        dataType: string
        lineageTag: 8fc276b9-baf3-53a3-bfa1-f230fe76e6ff
        summarizeBy: none
        sourceColumn: ExternalDomain

    column CreatedDateTime
        dataType: dateTime
        formatString: General Date
        lineageTag: d30d2856-88fc-57e2-b065-611e88da3775
