    measure 'Member Count' = CALCULATE(COUNTROWS(UsersCurrent), UsersCurrent[UserType] = "Member")
        formatString: #,0
        lineageTag: 5cdb94b4-37f3-593d-b124-6fe3e18bca40

    partition UsersCurrent = calculated
        mode: import
        source =
            FILTER(Users, Users[RunDate] = MAX(Users[RunDate]))

    annotation PBI_ResultType = Table
