    column TargetUserOrGroupType
        dataType: string
        lineageTag: 658462d0-f70c-54a1-909b-95e2c1883035
        summarizeBy: none
        sourceColumn: TargetUserOrGroupType

    column ActivityDate = DATE(YEAR(SharingEvents[CreationTime]), MONTH(SharingEvents[CreationTime]), DAY(SharingEvents[CreationTime]))
        dataType: dateTime
        formatString: Short Date
        lineageTag: 638a0930-5027-59c9-bc81-8e6608dc4f13
        summarizeBy: none
        isDataTypeInferred: false

    measure 'Sharing Event Count' = COUNTROWS(SharingEvents)
        formatString: #,0
        lineageTag: 428be8ee-95f7-5018-ab00-b29f8feae689

    partition SharingEvents = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents(CsvFolder & "\sharing-events.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                AllText = Table.TransformColumnTypes(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, type text})),
                Cleaned = Table.ReplaceValue(AllText, "", null, Replacer.ReplaceValue, Table.ColumnNames(AllText)),
                ParseUtc = (value as nullable text) as nullable datetime =>
                    if value = null then null else DateTime.FromText(value, [Format="yyyy-MM-dd'T'HH:mm:ss'Z'", Culture="en-US"]),
                #"Changed Type" = Table.TransformColumns(Cleaned, {{"CreationTime", ParseUtc, type datetime}})
            in
                #"Changed Type"

    annotation PBI_ResultType = Table
