        summarizeBy: none
        sourceColumn: CreationTime

    column Id
        dataType: string
        lineageTag: 9fdedbc0-4911-5e8b-b299-cc1ff3ed5a6a
        summarizeBy: none
        sourceColumn: Id

    column Operation
        dataType: string
        lineageTag: 9652a0b5-17ed-53c2-960f-c19283f99c3f
        summarizeBy: none
        sourceColumn: Operation

    column UserId
        dataType: string
        lineageTag: 9ccb8854-18bc-57b7-b998-6ba27b41e561
        summarizeBy: none
        sourceColumn: UserId

    column Workload
        dataType: string
        lineageTag: a3f64816-9186-565e-8fba-4d84ebaf1372
        summarizeBy: none
        sourceColumn: Workload

    column SiteUrl
        dataType: string
        lineageTag: 848cba7a-fe57-50ab-8171-ce2caaeba428
        summarizeBy: none
