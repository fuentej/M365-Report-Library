{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "column-by-state",
  "position": {
    "x": 810,
    "y": 100,
    "z": 0,
    "width": 470,
    "height": 280,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Guests"
                    }
                  },
                  "Property": "ExternalUserState"
                }
              },
              "queryRef": "Guests.ExternalUserState"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Guests"
                    }
                  },
                  "Property": "Guest Count"
                }
              },
              "queryRef": "Guests.Guest Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Guests by invitation state"
          }
        }
      ]
    }
  }
}
