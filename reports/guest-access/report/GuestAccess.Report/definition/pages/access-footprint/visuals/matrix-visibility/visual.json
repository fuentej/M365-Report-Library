{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "matrix-visibility",
  "position": {
    "x": 0,
    "y": 100,
    "z": 0,
    "width": 700,
    "height": 400,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GuestsCurrent"
                    }
                  },
                  "Property": "Pseudonym"
                }
              },
              "queryRef": "GuestsCurrent.Pseudonym"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Guests"
                    }
                  },
                  "Property": "Guest Display Name"
                }
              },
              "queryRef": "Guests.Guest Display Name"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GuestMemberships"
                    }
                  },
                  "Property": "Visibility"
                }
              },
              "queryRef": "GuestMemberships.Visibility"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GuestMemberships"
                    }
                  },
                  "Property": "Membership Count"
                }
              },
              "queryRef": "GuestMemberships.Membership Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": "Each guest's memberships by visibility"
          }
        }
      ]
    }
  }
}
